      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/treatyCountry">
      <Name>Treaty Country</Name>
      <Description>Country of treaty claimed.</Description>
      <Writable>
        <String />
      </Writable>
    </Fact>

    <Fact path="/treatyArticle">
      <Name>Treaty Article</Name>
      <Description>Treaty article number claimed.</Description>
      <Writable>
        <String />
      </Writable>
    </Fact>

    <Fact path="/treatyExemptIncome">
      <Name>Treaty Exempt Income</Name>
      <Description>Income exempt under treaty.</Description>
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
