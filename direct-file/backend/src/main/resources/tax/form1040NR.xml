    <Fact path="/taxableIncomeNR">
      <Name>Taxable Income - NR</Name>
      <Description>Taxable income for nonresident alien.</Description>
      <Export mef="true" />
      <Derived>
        <Max>
          <Dollar>0</Dollar>
          <Subtract>
            <Dependency path="/totalECI" />
            <Dependency path="/itemizedDeductionsNR" />
          </Subtract>
        </Max>
      </Derived>
    </Fact>

