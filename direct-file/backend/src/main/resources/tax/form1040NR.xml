    <Fact path="/itemizedDeductionsNR">
      <Name>Itemized Deductions - NR</Name>
      <Description>Itemized deductions for nonresident aliens.</Description>
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
