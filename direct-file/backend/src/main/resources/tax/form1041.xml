    <Fact path="/fiduciaryNetInvestmentIncomeTax">
      <Name>Net Investment Income Tax</Name>
      <Description>Net investment income tax (3.8%) for estates and trusts.</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Switch>
          <Case>
            <When>
              <GreaterThan>
                <Left><Dependency path="/fiduciaryAdjustedTotalIncome" /></Left>
                <Right><Dependency path="/fiduciaryTaxBracket35Max" /></Right>
              </GreaterThan>
            </When>
            <Then>
              <Multiply>
                <Subtract>
                  <Dependency path="/fiduciaryAdjustedTotalIncome" />
                  <Dependency path="/fiduciaryTaxBracket35Max" />
                </Subtract>
                <Decimal>0.038</Decimal>
              </Multiply>
            </Then>
          </Case>
          <Case>
            <When>
              <True />
            </When>
            <Then>
              <Dollar>0</Dollar>
            </Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>

    <Fact path="/fiduciaryTotalTax">
      <Name>Total Tax</Name>
      <Description>Total tax (Line 24).</Description>
      <Export mef="true" downstreamFacts="true" />
      <Derived>
        <Max>
          <Dollar>0</Dollar>
          <Add>
            <Subtract>
              <Dependency path="/fiduciaryTaxBeforeCredits" />
              <Dependency path="/fiduciaryTotalCredits" />
            </Subtract>
            <Dependency path="/fiduciaryNetInvestmentIncomeTax" />
          </Add>
        </Max>
      </Derived>
    </Fact>

    <!-- ============================================ -->
    <!-- SCHEDULE K-1 (BENEFICIARY ALLOCATIONS)      -->
    <!-- ============================================ -->

    <Fact path="/fiduciaryK1InterestIncome">
      <Name>K-1 Interest Income</Name>
      <Description>Interest income allocable to beneficiaries.</Description>
      <Derived>
        <Switch>
          <Case>
            <When>
              <GreaterThan>
                <Left><Dependency path="/fiduciaryIncomeDistributionDeduction" /></Left>
                <Right><Dollar>0</Dollar></Right>
              </GreaterThan>
            </When>
            <Then>
              <!-- Proportionate share based on distribution -->
              <Multiply>
                <Dependency path="/fiduciaryInterestIncome" />
                <Divide>
                  <Dependency path="/fiduciaryIncomeDistributionDeduction" />
                  <Dependency path="/fiduciaryDistributableNetIncome" />
                </Divide>
              </Multiply>
            </Then>
          </Case>
          <Case>
            <When>
              <True />
            </When>
            <Then>
              <Dollar>0</Dollar>
            </Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>

    <Fact path="/fiduciaryK1Dividends">
      <Name>K-1 Dividends</Name>
      <Description>Dividends allocable to beneficiaries.</Description>
      <Derived>
        <Switch>
          <Case>
            <When>
              <GreaterThan>
                <Left><Dependency path="/fiduciaryIncomeDistributionDeduction" /></Left>
                <Right><Dollar>0</Dollar></Right>
              </GreaterThan>
            </When>
            <Then>
              <Multiply>
                <Dependency path="/fiduciaryOrdinaryDividends" />
                <Divide>
                  <Dependency path="/fiduciaryIncomeDistributionDeduction" />
                  <Dependency path="/fiduciaryDistributableNetIncome" />
                </Divide>
              </Multiply>
            </Then>
          </Case>
          <Case>
            <When>
              <True />
            </When>
            <Then>
              <Dollar>0</Dollar>
            </Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>

