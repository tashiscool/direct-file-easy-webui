<?xml-model href="./FactDictionaryModule.rng"?>
<!-- Form 1041: U.S. Income Tax Return for Estates and Trusts -->
<FactDictionaryModule>
  <Facts>
    <!-- ============================================ -->
    <!-- ESTATE/TRUST INFORMATION                    -->
    <!-- ============================================ -->

    <Fact path="/isEstateOrTrust">
      <Name>Is Estate or Trust</Name>
      <Description>Whether entity is an estate or trust.</Description>
      <Derived>
        <Any>
          <Equals>
            <Left><Dependency module="form1120" path="/entityType" /></Left>
            <Right><Enum optionsPath="/__enumOptions/entityType">estate</Enum></Right>
          </Equals>
          <Equals>
            <Left><Dependency module="form1120" path="/entityType" /></Left>
            <Right><Enum optionsPath="/__enumOptions/entityType">trust</Enum></Right>
          </Equals>
        </Any>
      </Derived>
    </Fact>

    <Fact path="/fiduciaryEntityType">
      <Name>Fiduciary Entity Type</Name>
      <Description>Type of fiduciary entity.</Description>
      <Writable>
        <Enum>
          <EnumOption>decedentEstate</EnumOption>
          <EnumOption>simpleTrust</EnumOption>
          <EnumOption>complexTrust</EnumOption>
          <EnumOption>grantorTrust</EnumOption>
          <EnumOption>qualifiedDisabilityTrust</EnumOption>
          <EnumOption>esbt</EnumOption>
          <EnumOption>bankruptcyEstate</EnumOption>
          <EnumOption>pooledIncomeFund</EnumOption>
        </Enum>
      </Writable>
    </Fact>

    <Fact path="/estateTrustName">
      <Name>Estate/Trust Name</Name>
      <Description>Name of the estate or trust.</Description>
      <Writable>
        <String />
      </Writable>
    </Fact>

    <Fact path="/estateTrustEIN">
      <Name>Estate/Trust EIN</Name>
      <Description>Employer Identification Number.</Description>
      <Writable>
        <String />
      </Writable>
    </Fact>

    <Fact path="/fiduciaryName">
      <Name>Fiduciary Name</Name>
      <Description>Name of the fiduciary (trustee, executor, etc.).</Description>
      <Writable>
        <String />
      </Writable>
    </Fact>

    <Fact path="/fiduciaryAddress">
      <Name>Fiduciary Address</Name>
      <Description>Address of the fiduciary.</Description>
      <Writable>
        <String />
      </Writable>
    </Fact>

    <Fact path="/decedentSSN">
      <Name>Decedent's SSN</Name>
      <Description>Social Security Number of decedent (for estates).</Description>
      <Writable>
        <String />
      </Writable>
    </Fact>

    <Fact path="/dateOfDeath">
      <Name>Date of Death</Name>
      <Description>Date of decedent's death (for estates).</Description>
      <Writable>
        <Date />
      </Writable>
    </Fact>

    <Fact path="/dateCreated">
      <Name>Date Trust Created</Name>
      <Description>Date the trust was created.</Description>
      <Writable>
        <Date />
      </Writable>
    </Fact>

    <Fact path="/numberOfBeneficiaries">
      <Name>Number of Beneficiaries</Name>
      <Description>Number of beneficiaries.</Description>
      <Writable>
        <Int>
          <Limit operation="Min" level="ERROR">
            <IntNode>1</IntNode>
          </Limit>
        </Int>
      </Writable>
    </Fact>

    <!-- ============================================ -->
    <!-- INCOME                                      -->
    <!-- ============================================ -->

    <Fact path="/fiduciaryInterestIncome">
      <Name>Interest Income</Name>
      <Description>Interest income (Line 1).</Description>
      <Export mef="true" />
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/fiduciaryOrdinaryDividends">
      <Name>Ordinary Dividends</Name>
      <Description>Ordinary dividends (Line 2a).</Description>
      <Export mef="true" />
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/fiduciaryQualifiedDividends">
      <Name>Qualified Dividends</Name>
      <Description>Qualified dividends (Line 2b).</Description>
      <Export mef="true" />
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/fiduciaryBusinessIncome">
      <Name>Business Income</Name>
      <Description>Business income or loss (Schedule C or C-EZ) (Line 3).</Description>
      <Writable>
        <Dollar />
      </Writable>
    </Fact>

    <Fact path="/fiduciaryCapitalGain">
      <Name>Capital Gain or Loss</Name>
      <Description>Capital gain or loss (Schedule D) (Line 4).</Description>
      <Export mef="true" />
      <Writable>
        <Dollar />
      </Writable>
    </Fact>

    <Fact path="/fiduciaryRentsRoyalties">
      <Name>Rents, Royalties, etc.</Name>
      <Description>Rents, royalties, partnerships, other estates/trusts (Schedule E) (Line 5).</Description>
      <Writable>
        <Dollar />
      </Writable>
    </Fact>

    <Fact path="/fiduciaryFarmIncome">
      <Name>Farm Income</Name>
      <Description>Farm income or loss (Schedule F) (Line 6).</Description>
      <Writable>
        <Dollar />
      </Writable>
    </Fact>

    <Fact path="/fiduciaryOrdinaryGain4797">
      <Name>Ordinary Gain from Form 4797</Name>
      <Description>Ordinary gain or loss from Form 4797 (Line 7).</Description>
      <Writable>
        <Dollar />
      </Writable>
    </Fact>

    <Fact path="/fiduciaryOtherIncome">
      <Name>Other Income</Name>
      <Description>Other income (Line 8).</Description>
      <Writable>
        <Dollar />
      </Writable>
    </Fact>

    <Fact path="/fiduciaryTotalIncome">
      <Name>Total Income</Name>
      <Description>Total income (Line 9).</Description>
      <Export mef="true" />
      <Derived>
        <Add>
          <Add>
            <Add>
              <Add>
                <Add>
                  <Add>
                    <Add>
                      <Dependency path="/fiduciaryInterestIncome" />
                      <Dependency path="/fiduciaryOrdinaryDividends" />
                    </Add>
                    <Dependency path="/fiduciaryBusinessIncome" />
                  </Add>
                  <Dependency path="/fiduciaryCapitalGain" />
                </Add>
                <Dependency path="/fiduciaryRentsRoyalties" />
              </Add>
              <Dependency path="/fiduciaryFarmIncome" />
            </Add>
            <Dependency path="/fiduciaryOrdinaryGain4797" />
          </Add>
          <Dependency path="/fiduciaryOtherIncome" />
        </Add>
      </Derived>
    </Fact>

    <!-- ============================================ -->
