          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/fiduciaryOtherDeductions">
      <Name>Other Deductions</Name>
      <Description>Other deductions (Line 15a).</Description>
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/fiduciaryNOLDeduction">
      <Name>NOL Deduction</Name>
      <Description>Net operating loss deduction (Line 15b).</Description>
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/fiduciaryTotalDeductionsBeforeDist">
      <Name>Total Deductions Before Distributions</Name>
      <Description>Total deductions before income distribution (Line 16).</Description>
      <Derived>
        <Add>
          <Add>
            <Add>
              <Add>
                <Add>
                  <Add>
                    <Dependency path="/fiduciaryInterestExpense" />
                    <Dependency path="/fiduciaryTaxes" />
                  </Add>
                  <Dependency path="/fiduciaryFiduciaryFees" />
                </Add>
                <Dependency path="/fiduciaryCharitableDeduction" />
              </Add>
              <Dependency path="/fiduciaryAttorneyFees" />
            </Add>
            <Dependency path="/fiduciaryOtherDeductions" />
          </Add>
          <Dependency path="/fiduciaryNOLDeduction" />
        </Add>
      </Derived>
    </Fact>

    <Fact path="/fiduciaryAdjustedTotalIncome">
      <Name>Adjusted Total Income</Name>
      <Description>Adjusted total income (Line 17).</Description>
      <Derived>
        <Subtract>
          <Dependency path="/fiduciaryTotalIncome" />
          <Dependency path="/fiduciaryTotalDeductionsBeforeDist" />
        </Subtract>
      </Derived>
    </Fact>

    <Fact path="/adjustedTotalIncome">
      <Name>Adjusted Total Income</Name>
      <Description>Legacy compatibility alias for fiduciary adjusted total income.</Description>
      <Derived>
        <Dependency path="/fiduciaryAdjustedTotalIncome" />
      </Derived>
    </Fact>

    <!-- ============================================ -->
    <!-- INCOME DISTRIBUTION DEDUCTION (DNI)         -->
    <!-- ============================================ -->

    <Fact path="/fiduciaryDistributableNetIncome">
      <Name>Distributable Net Income (DNI)</Name>
      <Description>Distributable net income (Schedule B).</Description>
      <Export mef="true" />
      <Derived>
        <!-- Simplified: DNI = Adjusted Total Income + Tax-Exempt Interest - Capital Gains allocated to corpus -->
        <Max>
          <Dollar>0</Dollar>
          <Subtract>
            <Dependency path="/fiduciaryAdjustedTotalIncome" />
            <Max>
              <Dollar>0</Dollar>
              <Dependency path="/fiduciaryCapitalGain" />
            </Max>
          </Subtract>
        </Max>
      </Derived>
    </Fact>

    <Fact path="/fiduciaryIncomeRequiredDistributed">
      <Name>Income Required to be Distributed</Name>
      <Description>Income required to be distributed currently (Line 18).</Description>
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/fiduciaryOtherAmountsDistributed">
      <Name>Other Amounts Distributed</Name>
      <Description>Other amounts paid, credited, or required (Line 19).</Description>
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/fiduciaryTotalDistributions">
      <Name>Total Distributions</Name>
      <Description>Total distributions to beneficiaries.</Description>
      <Derived>
        <Add>
          <Dependency path="/fiduciaryIncomeRequiredDistributed" />
          <Dependency path="/fiduciaryOtherAmountsDistributed" />
        </Add>
      </Derived>
    </Fact>

    <Fact path="/fiduciaryIncomeDistributionDeduction">
      <Name>Income Distribution Deduction</Name>
      <Description>Income distribution deduction (Line 20).</Description>
      <Export mef="true" />
      <Derived>
        <!-- Lesser of DNI or distributions -->
        <Min>
          <Dependency path="/fiduciaryDistributableNetIncome" />
          <Dependency path="/fiduciaryTotalDistributions" />
        </Min>
      </Derived>
    </Fact>

    <!-- ============================================ -->
    <!-- EXEMPTION                                   -->
    <!-- ============================================ -->

    <Fact path="/fiduciaryExemptionAmount">
      <Name>Exemption Amount</Name>
      <Description>Exemption amount based on entity type.</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Switch>
          <Case>
            <When>
              <Equals>
                <Left><Dependency path="/fiduciaryEntityType" /></Left>
                <Right><Enum optionsPath="/__enumOptions/fiduciaryEntityType">decedentEstate</Enum></Right>
              </Equals>
            </When>
            <Then>
              <Dollar>600</Dollar>
            </Then>
          </Case>
          <Case>
            <When>
              <Equals>
                <Left><Dependency path="/fiduciaryEntityType" /></Left>
                <Right><Enum optionsPath="/__enumOptions/fiduciaryEntityType">simpleTrust</Enum></Right>
              </Equals>
            </When>
            <Then>
              <Dollar>300</Dollar>
            </Then>
          </Case>
          <Case>
            <When>
              <Equals>
                <Left><Dependency path="/fiduciaryEntityType" /></Left>
                <Right><Enum optionsPath="/__enumOptions/fiduciaryEntityType">qualifiedDisabilityTrust</Enum></Right>
              </Equals>
            </When>
            <Then>
              <!-- QDT gets individual exemption equivalent -->
              <Dollar>4700</Dollar>
            </Then>
          </Case>
          <Case>
            <When>
              <True />
            </When>
            <Then>
              <Dollar>100</Dollar>
            </Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>

    <!-- ============================================ -->
    <!-- TAXABLE INCOME                              -->
    <!-- ============================================ -->

    <Fact path="/fiduciaryTaxableIncome">
      <Name>Taxable Income</Name>
      <Description>Taxable income (Line 22).</Description>
      <Export mef="true" downstreamFacts="true" />
      <Derived>
        <Max>
          <Dollar>0</Dollar>
          <Subtract>
            <Subtract>
              <Dependency path="/fiduciaryAdjustedTotalIncome" />
              <Dependency path="/fiduciaryIncomeDistributionDeduction" />
            </Subtract>
            <Dependency path="/fiduciaryExemptionAmount" />
          </Subtract>
        </Max>
      </Derived>
    </Fact>

    <!-- ============================================ -->
    <!-- TAX CALCULATION - COMPRESSED BRACKETS       -->
    <!-- ============================================ -->

    <Fact path="/fiduciaryTaxBracket10Max">
      <Name>10% Bracket Maximum</Name>
      <Description>Maximum income taxed at 10%.</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Dollar>3150</Dollar>
      </Derived>
    </Fact>

    <Fact path="/fiduciaryTaxBracket24Max">
      <Name>24% Bracket Maximum</Name>
      <Description>Maximum income taxed at 24%.</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Dollar>11450</Dollar>
      </Derived>
    </Fact>

    <Fact path="/fiduciaryTaxBracket35Max">
      <Name>35% Bracket Maximum</Name>
      <Description>Maximum income taxed at 35%.</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Dollar>15650</Dollar>
      </Derived>
    </Fact>

    <Fact path="/fiduciaryTaxAt10">
      <Name>Tax at 10%</Name>
      <Description>Tax calculated at 10% rate.</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Multiply>
          <Min>
            <Dependency path="/fiduciaryTaxableIncome" />
            <Dependency path="/fiduciaryTaxBracket10Max" />
          </Min>
          <Decimal>0.10</Decimal>
        </Multiply>
      </Derived>
    </Fact>

    <Fact path="/fiduciaryTaxAt24">
      <Name>Tax at 24%</Name>
      <Description>Tax calculated at 24% rate.</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Switch>
          <Case>
            <When>
              <GreaterThan>
                <Left><Dependency path="/fiduciaryTaxableIncome" /></Left>
                <Right><Dependency path="/fiduciaryTaxBracket10Max" /></Right>
              </GreaterThan>
            </When>
            <Then>
              <Multiply>
                <Subtract>
                  <Min>
                    <Dependency path="/fiduciaryTaxableIncome" />
                    <Dependency path="/fiduciaryTaxBracket24Max" />
                  </Min>
                  <Dependency path="/fiduciaryTaxBracket10Max" />
                </Subtract>
                <Decimal>0.24</Decimal>
              </Multiply>
            </Then>
          </Case>
          <Case>
            <When>
              <True />
            </When>
            <Then>
              <Dollar>0</Dollar>
            </Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>

    <Fact path="/fiduciaryTaxAt35">
      <Name>Tax at 35%</Name>
      <Description>Tax calculated at 35% rate.</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Switch>
          <Case>
            <When>
              <GreaterThan>
                <Left><Dependency path="/fiduciaryTaxableIncome" /></Left>
                <Right><Dependency path="/fiduciaryTaxBracket24Max" /></Right>
              </GreaterThan>
            </When>
            <Then>
              <Multiply>
                <Subtract>
                  <Min>
                    <Dependency path="/fiduciaryTaxableIncome" />
                    <Dependency path="/fiduciaryTaxBracket35Max" />
                  </Min>
                  <Dependency path="/fiduciaryTaxBracket24Max" />
                </Subtract>
                <Decimal>0.35</Decimal>
              </Multiply>
            </Then>
          </Case>
          <Case>
            <When>
              <True />
            </When>
            <Then>
              <Dollar>0</Dollar>
            </Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>

    <Fact path="/fiduciaryTaxAt37">
      <Name>Tax at 37%</Name>
      <Description>Tax calculated at 37% rate.</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Switch>
          <Case>
            <When>
              <GreaterThan>
                <Left><Dependency path="/fiduciaryTaxableIncome" /></Left>
                <Right><Dependency path="/fiduciaryTaxBracket35Max" /></Right>
              </GreaterThan>
            </When>
            <Then>
              <Multiply>
                <Subtract>
                  <Dependency path="/fiduciaryTaxableIncome" />
                  <Dependency path="/fiduciaryTaxBracket35Max" />
                </Subtract>
                <Decimal>0.37</Decimal>
              </Multiply>
            </Then>
          </Case>
          <Case>
            <When>
              <True />
            </When>
            <Then>
              <Dollar>0</Dollar>
            </Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>

    <Fact path="/fiduciaryTaxBeforeCredits">
      <Name>Tax Before Credits</Name>
      <Description>Total tax before credits (Line 23).</Description>
      <Export mef="true" />
      <Derived>
        <Round>
          <Add>
            <Add>
              <Add>
                <Dependency path="/fiduciaryTaxAt10" />
                <Dependency path="/fiduciaryTaxAt24" />
              </Add>
              <Dependency path="/fiduciaryTaxAt35" />
            </Add>
            <Dependency path="/fiduciaryTaxAt37" />
          </Add>
        </Round>
      </Derived>
    </Fact>

    <Fact path="/taxBeforeCredits1041">
      <Name>Tax Before Credits 1041</Name>
      <Description>Legacy compatibility alias for fiduciary tax before credits.</Description>
      <Derived>
        <Dependency path="/fiduciaryTaxBeforeCredits" />
      </Derived>
    </Fact>

