<?xml-model href="./FactDictionaryModule.rng"?>
<!-- Form 1065: U.S. Return of Partnership Income -->
<FactDictionaryModule>
  <Facts>
    <!-- ============================================ -->
    <!-- PARTNERSHIP INFORMATION                     -->
    <!-- ============================================ -->

    <Fact path="/isPartnership">
      <Name>Is Partnership</Name>
      <Description>Whether entity is a partnership.</Description>
      <Derived>
        <Any>
          <Equals>
            <Left><Dependency module="form1120" path="/entityType" /></Left>
            <Right><Enum>partnership</Enum></Right>
          </Equals>
          <Equals>
            <Left><Dependency module="form1120" path="/entityType" /></Left>
            <Right><Enum>llcPartnership</Enum></Right>
          </Equals>
        </Any>
      </Derived>
    </Fact>

    <Fact path="/partnershipName">
      <Name>Partnership Name</Name>
      <Description>Legal name of the partnership.</Description>
      <Writable>
        <String />
      </Writable>
    </Fact>

    <Fact path="/partnershipEIN">
      <Name>Partnership EIN</Name>
      <Description>Employer Identification Number.</Description>
      <Writable>
        <String />
      </Writable>
    </Fact>

    <Fact path="/partnershipFormationDate">
      <Name>Formation Date</Name>
      <Description>Date the partnership was formed.</Description>
      <Writable>
        <Date />
      </Writable>
    </Fact>

    <Fact path="/partnershipType">
      <Name>Partnership Type</Name>
      <Description>Type of partnership.</Description>
      <Writable>
        <Enum>
          <EnumOption>generalPartnership</EnumOption>
          <EnumOption>limitedPartnership</EnumOption>
          <EnumOption>llp</EnumOption>
          <EnumOption>llc</EnumOption>
          <EnumOption>other</EnumOption>
        </Enum>
      </Writable>
    </Fact>

    <Fact path="/numberOfPartners">
      <Name>Number of Partners</Name>
      <Description>Number of partners during the year.</Description>
      <Writable>
        <Int>
          <Limit operation="Min" level="ERROR">
            <IntNode>2</IntNode>
          </Limit>
        </Int>
      </Writable>
    </Fact>

    <Fact path="/partnershipPrincipalActivity">
      <Name>Principal Business Activity</Name>
      <Description>Principal business activity code.</Description>
      <Writable>
        <String />
      </Writable>
    </Fact>

