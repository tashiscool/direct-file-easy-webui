    <Fact path="/pshipTotalIncome">
      <Name>Total Income</Name>
      <Description>Total income (loss) (Line 8).</Description>
      <Export mef="true" />
      <Derived>
        <Add>
          <Add>
            <Add>
              <Add>
                <Add>
                  <Dependency path="/pshipGrossProfit" />
                  <Dependency path="/pshipOrdinaryIncomeOther" />
                </Add>
                <Dependency path="/pshipNetFarmProfit" />
              </Add>
              <Dependency path="/pshipNetGainLoss4797" />
            </Add>
            <Dependency path="/pshipOtherIncome" />
          </Add>
          <!-- Guaranteed payments are not included in line 8 -->
          <Dollar>0</Dollar>
        </Add>
      </Derived>
    </Fact>

