<?xml-model href="./FactDictionaryModule.rng"?>
<!-- Form 1120: U.S. Corporation Income Tax Return -->
<FactDictionaryModule>
  <Facts>
    <!-- ============================================ -->
    <!-- ENTITY INFORMATION                          -->
    <!-- ============================================ -->

    <Fact path="/entityType">
      <Name>Entity Type</Name>
      <Description>Type of business entity for tax purposes.</Description>
      <Writable>
        <Enum>
          <EnumOption>cCorporation</EnumOption>
          <EnumOption>sCorporation</EnumOption>
          <EnumOption>partnership</EnumOption>
          <EnumOption>soleProprietorship</EnumOption>
          <EnumOption>llcSingleMember</EnumOption>
          <EnumOption>llcPartnership</EnumOption>
          <EnumOption>llcCorporation</EnumOption>
          <EnumOption>estate</EnumOption>
          <EnumOption>trust</EnumOption>
          <EnumOption>nonProfit</EnumOption>
        </Enum>
      </Writable>
    </Fact>

    <Fact path="/isCCorporation">
      <Name>Is C Corporation</Name>
      <Description>Whether entity is taxed as a C Corporation.</Description>
      <Derived>
        <Any>
          <Equals>
            <Left><Dependency path="/entityType" /></Left>
            <Right><Enum optionsPath="/__enumOptions/entityType">cCorporation</Enum></Right>
          </Equals>
          <Equals>
            <Left><Dependency path="/entityType" /></Left>
            <Right><Enum optionsPath="/__enumOptions/entityType">llcCorporation</Enum></Right>
          </Equals>
        </Any>
      </Derived>
    </Fact>

    <Fact path="/corporateName">
      <Name>Corporate Name</Name>
      <Description>Legal name of the corporation.</Description>
      <Writable>
        <String />
      </Writable>
    </Fact>

    <Fact path="/corporateEIN">
      <Name>Corporate EIN</Name>
      <Description>Employer Identification Number.</Description>
