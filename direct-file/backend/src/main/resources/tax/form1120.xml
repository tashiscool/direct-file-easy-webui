    </Fact>

    <Fact path="/dateIncorporated">
      <Name>Date Incorporated</Name>
      <Description>Date the corporation was incorporated.</Description>
      <Writable>
        <Date />
      </Writable>
    </Fact>

    <Fact path="/stateOfIncorporation">
      <Name>State of Incorporation</Name>
      <Description>State where corporation was incorporated.</Description>
      <Writable>
        <String />
      </Writable>
    </Fact>

    <Fact path="/fiscalYearEnd">
      <Name>Fiscal Year End</Name>
      <Description>Month fiscal year ends (1-12).</Description>
      <Writable>
        <Int>
          <Limit operation="Min" level="ERROR">
            <IntNode>1</IntNode>
          </Limit>
          <Limit operation="Max" level="ERROR">
            <IntNode>12</IntNode>
          </Limit>
        </Int>
      </Writable>
    </Fact>

    <Fact path="/totalAssets">
