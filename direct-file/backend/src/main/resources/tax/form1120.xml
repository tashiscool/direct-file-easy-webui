    <Fact path="/corpDividendsReceivedDeduction">
      <Name>Dividends Received Deduction</Name>
      <Description>Dividends received deduction (Schedule C).</Description>
      <Export mef="true" />
      <Derived>
        <!-- Simplified: 50% DRD for less than 20% ownership -->
        <Multiply>
          <Dependency path="/corpDividendsReceived" />
          <Decimal>0.50</Decimal>
        </Multiply>
      </Derived>
    </Fact>

    <Fact path="/corpSpecialDeductions">
      <Name>Special Deductions</Name>
      <Description>Total special deductions (Line 29b).</Description>
