    <Fact path="/sCorpBuiltInGainsTax">
      <Name>Built-In Gains Tax</Name>
      <Description>Tax on built-in gains (21% rate).</Description>
      <Export mef="true" />
      <TaxYear>2025</TaxYear>
      <Derived>
        <Switch>
          <Case>
            <When>
              <Dependency path="/sCorpHasBuiltInGains" />
            </When>
            <Then>
              <Multiply>
                <Dependency path="/sCorpNetRecognizedBuiltInGain" />
                <Decimal>0.21</Decimal>
              </Multiply>
            </Then>
          </Case>
          <Case>
            <When>
              <True />
            </When>
            <Then>
              <Dollar>0</Dollar>
            </Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>

