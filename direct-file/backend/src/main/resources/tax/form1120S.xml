    <Fact path="/sCorpExcessPassiveIncomeTax">
      <Name>Excess Passive Income Tax</Name>
      <Description>Tax on excess net passive income.</Description>
      <Export mef="true" />
      <TaxYear>2025</TaxYear>
      <Derived>
        <Switch>
          <Case>
            <When>
              <All>
                <Dependency path="/sCorpHasExcessPassiveIncome" />
                <GreaterThan>
                  <Left><Dependency path="/sCorpAccumulatedEarningsAndProfits" /></Left>
                  <Right><Dollar>0</Dollar></Right>
                </GreaterThan>
                <GreaterThan>
                  <Left><Dependency path="/sCorpPassiveInvestmentIncome" /></Left>
                  <Right>
                    <Multiply>
                      <Dependency path="/sCorpGrossReceiptsForPassive" />
                      <Decimal>0.25</Decimal>
                    </Multiply>
                  </Right>
                </GreaterThan>
              </All>
            </When>
            <Then>
              <!-- Simplified calculation -->
              <Multiply>
                <Subtract>
                  <Dependency path="/sCorpPassiveInvestmentIncome" />
                  <Multiply>
                    <Dependency path="/sCorpGrossReceiptsForPassive" />
                    <Decimal>0.25</Decimal>
                  </Multiply>
                </Subtract>
                <Decimal>0.21</Decimal>
              </Multiply>
            </Then>
          </Case>
          <Case>
            <When>
              <True />
            </When>
            <Then>
              <Dollar>0</Dollar>
            </Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>

