<?xml-model href="./FactDictionaryModule.rng"?>
<!-- Form 8936: Qualified Plug-in Electric Drive Motor Vehicle Credit -->
<FactDictionaryModule>
  <Facts>
    <Fact path="/hasPlugInVehicleCredit">
      <Name>Has Plug-in Vehicle Credit</Name>
      <Description>Whether taxpayer claims plug-in vehicle credit.</Description>
      <Export mef="true" />
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/vehicleYear8936">
      <Name>Vehicle Year</Name>
      <Description>Model year of vehicle.</Description>
      <Writable>
        <String />
      </Writable>
    </Fact>

    <Fact path="/vehicleMake8936">
      <Name>Vehicle Make</Name>
      <Description>Make of vehicle.</Description>
      <Writable>
        <String />
      </Writable>
    </Fact>

    <Fact path="/vehicleModel8936">
      <Name>Vehicle Model</Name>
      <Description>Model of vehicle.</Description>
      <Writable>
        <String />
      </Writable>
    </Fact>

    <Fact path="/vehicleVIN8936">
      <Name>Vehicle VIN</Name>
      <Description>Vehicle identification number.</Description>
      <Writable>
        <String />
      </Writable>
    </Fact>

    <Fact path="/datePlacedInService8936">
      <Name>Date Placed in Service</Name>
      <Description>Date vehicle was placed in service.</Description>
      <Writable>
        <String />
      </Writable>
    </Fact>

    <Fact path="/vehicleMSRP8936">
      <Name>Vehicle MSRP</Name>
      <Description>Manufacturer's suggested retail price.</Description>
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/msrpLimitVan">
      <Name>MSRP Limit Van/SUV/Truck</Name>
      <Description>MSRP limit for vans, SUVs, pickups ($80,000).</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Dollar>80000</Dollar>
      </Derived>
    </Fact>

    <Fact path="/msrpLimitOther">
      <Name>MSRP Limit Other</Name>
      <Description>MSRP limit for other vehicles ($55,000).</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Dollar>55000</Dollar>
      </Derived>
    </Fact>

    <Fact path="/isVanSUVTruck">
      <Name>Is Van/SUV/Truck</Name>
      <Description>Whether vehicle is van, SUV, or pickup truck.</Description>
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/meetsAssemblyRequirement8936">
      <Name>Meets Assembly Requirement</Name>
      <Description>Whether vehicle meets final assembly requirement.</Description>
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/meetsBatteryRequirement8936">
      <Name>Meets Battery Requirement</Name>
      <Description>Whether meets battery component requirement.</Description>
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/meetsMineralRequirement8936">
      <Name>Meets Mineral Requirement</Name>
      <Description>Whether meets critical mineral requirement.</Description>
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/tentativeCredit8936">
      <Name>Tentative Credit</Name>
      <Description>Tentative credit amount.</Description>
      <Derived>
        <Add>
          <Switch>
            <Case>
              <When><Dependency path="/meetsMineralRequirement8936" /></When>
              <Then><Dollar>3750</Dollar></Then>
            </Case>
            <Case>
              <When><True /></When>
              <Then><Dollar>0</Dollar></Then>
            </Case>
          </Switch>
          <Switch>
            <Case>
              <When><Dependency path="/meetsBatteryRequirement8936" /></When>
              <Then><Dollar>3750</Dollar></Then>
            </Case>
            <Case>
              <When><True /></When>
              <Then><Dollar>0</Dollar></Then>
            </Case>
          </Switch>
        </Add>
      </Derived>
    </Fact>

    <Fact path="/plugInVehicleCredit">
      <Name>Plug-in Vehicle Credit</Name>
      <Description>Plug-in electric vehicle credit amount.</Description>
      <Export mef="true" downstreamFacts="true" />
      <Derived>
        <Switch>
          <Case>
            <When>
              <Not><Dependency path="/meetsAssemblyRequirement8936" /></Not>
            </When>
            <Then><Dollar>0</Dollar></Then>
          </Case>
          <Case>
            <When><True /></When>
            <Then>
              <Dependency path="/tentativeCredit8936" />
            </Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>

    <Fact path="/form8936IsDone">
      <Name>Form 8936 Is Done</Name>
      <Description>Whether Form 8936 is complete.</Description>
      <Derived>
        <Any>
          <Not><Dependency path="/hasPlugInVehicleCredit" /></Not>
          <All>
            <Dependency path="/hasPlugInVehicleCredit" />
            <IsComplete><Dependency path="/plugInVehicleCredit" /></IsComplete>
          </All>
        </Any>
      </Derived>
    </Fact>

    <Fact path="/pdfIncludeForm8936">
      <Name>Include Form 8936 in PDF</Name>
      <Description>Whether to include Form 8936.</Description>
      <Derived>
        <GreaterThan>
          <Left><Dependency path="/plugInVehicleCredit" /></Left>
          <Right><Dollar>0</Dollar></Right>
        </GreaterThan>
      </Derived>
    </Fact>
  </Facts>
</FactDictionaryModule>
