<?xml-model href="./FactDictionaryModule.rng"?>
<!-- Form 8949: Sales and Other Dispositions of Capital Assets -->
<FactDictionaryModule>
  <Facts>
    <!-- ============================================ -->
    <!-- PART I: SHORT-TERM TRANSACTIONS             -->
    <!-- ============================================ -->

    <Fact path="/hasShortTermTransactions">
      <Name>Has Short-Term Transactions</Name>
      <Description>Whether taxpayer has short-term capital transactions.</Description>
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/shortTermBoxA">
      <Name>Short-Term Box A</Name>
      <Description>Short-term transactions reported on Form 1099-B with basis reported to IRS.</Description>
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/shortTermBoxB">
      <Name>Short-Term Box B</Name>
      <Description>Short-term transactions reported on Form 1099-B without basis reported to IRS.</Description>
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/shortTermBoxC">
      <Name>Short-Term Box C</Name>
      <Description>Short-term transactions not reported on Form 1099-B.</Description>
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/shortTermProceedsBoxA">
      <Name>Short-Term Proceeds - Box A</Name>
      <Description>Total proceeds from short-term Box A transactions.</Description>
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/shortTermCostBoxA">
      <Name>Short-Term Cost - Box A</Name>
      <Description>Total cost or basis from short-term Box A transactions.</Description>
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/shortTermAdjustmentsBoxA">
      <Name>Short-Term Adjustments - Box A</Name>
      <Description>Adjustments to gain/loss for short-term Box A transactions.</Description>
      <Writable>
        <Dollar />
      </Writable>
    </Fact>

    <Fact path="/shortTermGainLossBoxA">
      <Name>Short-Term Gain/Loss - Box A</Name>
      <Description>Net gain or loss from short-term Box A transactions.</Description>
      <Export mef="true" />
      <Derived>
        <Add>
          <Subtract>
            <Dependency path="/shortTermProceedsBoxA" />
            <Dependency path="/shortTermCostBoxA" />
          </Subtract>
          <Dependency path="/shortTermAdjustmentsBoxA" />
        </Add>
      </Derived>
    </Fact>

    <Fact path="/shortTermProceedsBoxB">
      <Name>Short-Term Proceeds - Box B</Name>
      <Description>Total proceeds from short-term Box B transactions.</Description>
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/shortTermCostBoxB">
      <Name>Short-Term Cost - Box B</Name>
      <Description>Total cost or basis from short-term Box B transactions.</Description>
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/shortTermGainLossBoxB">
      <Name>Short-Term Gain/Loss - Box B</Name>
      <Description>Net gain or loss from short-term Box B transactions.</Description>
      <Export mef="true" />
      <Derived>
        <Subtract>
          <Dependency path="/shortTermProceedsBoxB" />
          <Dependency path="/shortTermCostBoxB" />
        </Subtract>
      </Derived>
    </Fact>

    <Fact path="/shortTermProceedsBoxC">
      <Name>Short-Term Proceeds - Box C</Name>
      <Description>Total proceeds from short-term Box C transactions.</Description>
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/shortTermCostBoxC">
      <Name>Short-Term Cost - Box C</Name>
      <Description>Total cost or basis from short-term Box C transactions.</Description>
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/shortTermGainLossBoxC">
      <Name>Short-Term Gain/Loss - Box C</Name>
      <Description>Net gain or loss from short-term Box C transactions.</Description>
      <Export mef="true" />
      <Derived>
        <Subtract>
          <Dependency path="/shortTermProceedsBoxC" />
          <Dependency path="/shortTermCostBoxC" />
        </Subtract>
      </Derived>
    </Fact>

    <Fact path="/totalShortTermGainLoss">
      <Name>Total Short-Term Gain/Loss</Name>
      <Description>Total short-term capital gain or loss.</Description>
      <Export mef="true" />
      <Derived>
        <Add>
          <Add>
            <Dependency path="/shortTermGainLossBoxA" />
            <Dependency path="/shortTermGainLossBoxB" />
          </Add>
          <Dependency path="/shortTermGainLossBoxC" />
        </Add>
      </Derived>
    </Fact>

    <!-- ============================================ -->
