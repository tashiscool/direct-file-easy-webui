    <!-- ============================================ -->
    <!-- WASH SALE AND ADJUSTMENTS                   -->
    <!-- ============================================ -->

    <Fact path="/hasWashSales">
      <Name>Has Wash Sales</Name>
      <Description>Whether taxpayer has wash sale losses to disallow.</Description>
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/washSaleDisallowedLoss">
      <Name>Wash Sale Disallowed Loss</Name>
      <Description>Total disallowed loss from wash sales.</Description>
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <!-- ============================================ -->
    <!-- FLOW CONTROL                                -->
    <!-- ============================================ -->

    <Fact path="/form8949IsDone">
      <Name>Form 8949 Is Done</Name>
      <Description>Whether Form 8949 is complete.</Description>
      <Derived>
        <Any>
          <All>
            <Not><Dependency path="/hasShortTermTransactions" /></Not>
            <Not><Dependency path="/hasLongTermTransactions" /></Not>
          </All>
          <Any>
            <IsComplete><Dependency path="/totalShortTermGainLoss" /></IsComplete>
            <IsComplete><Dependency path="/totalLongTermGainLoss" /></IsComplete>
          </Any>
        </Any>
      </Derived>
    </Fact>

    <Fact path="/pdfIncludeForm8949">
      <Name>Include Form 8949 in PDF</Name>
      <Description>Whether to include Form 8949 in the tax return PDF.</Description>
      <Derived>
        <Any>
          <Dependency path="/hasShortTermTransactions" />
          <Dependency path="/hasLongTermTransactions" />
        </Any>
      </Derived>
    </Fact>
  </Facts>
</FactDictionaryModule>
