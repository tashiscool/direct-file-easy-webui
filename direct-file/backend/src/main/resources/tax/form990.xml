    <!-- ORGANIZATION INFORMATION                    -->
    <!-- ============================================ -->

    <Fact path="/isNonProfit">
      <Name>Is Non-Profit Organization</Name>
      <Description>Whether entity is a tax-exempt organization.</Description>
      <Derived>
        <Equals>
          <Left><Dependency module="form1120" path="/entityType" /></Left>
          <Right><Enum>nonProfit</Enum></Right>
        </Equals>
      </Derived>
    </Fact>

    <Fact path="/organizationName">
      <Name>Organization Name</Name>
      <Description>Legal name of the organization.</Description>
      <Writable>
        <String />
      </Writable>
    </Fact>

    <Fact path="/organizationEIN">
      <Name>Organization EIN</Name>
      <Description>Employer Identification Number.</Description>
      <Writable>
        <String />
      </Writable>
    </Fact>

    <Fact path="/organizationAddress">
      <Name>Organization Address</Name>
      <Description>Principal address of the organization.</Description>
      <Writable>
        <String />
      </Writable>
    </Fact>

    <Fact path="/exemptStatusCode">
      <Name>Exempt Status Code</Name>
      <Description>IRC section under which organization is exempt.</Description>
      <Writable>
        <Enum>
          <EnumOption>501c3</EnumOption>
          <EnumOption>501c4</EnumOption>
          <EnumOption>501c5</EnumOption>
          <EnumOption>501c6</EnumOption>
          <EnumOption>501c7</EnumOption>
          <EnumOption>501c8</EnumOption>
          <EnumOption>501c9</EnumOption>
          <EnumOption>501c10</EnumOption>
          <EnumOption>501c13</EnumOption>
          <EnumOption>501c19</EnumOption>
          <EnumOption>other</EnumOption>
        </Enum>
      </Writable>
    </Fact>

    <Fact path="/is501c3">
      <Name>Is 501(c)(3)</Name>
      <Description>Whether organization is exempt under 501(c)(3).</Description>
      <Derived>
        <Equals>
          <Left><Dependency path="/exemptStatusCode" /></Left>
          <Right><Enum>501c3</Enum></Right>
        </Equals>
      </Derived>
    </Fact>

    <Fact path="/organizationType501c3">
      <Name>501(c)(3) Organization Type</Name>
      <Description>Type of 501(c)(3) organization.</Description>
      <Writable>
        <Enum>
          <EnumOption>publicCharity170b1Avi</EnumOption>
          <EnumOption>publicCharity170b1Avii</EnumOption>
          <EnumOption>publicCharity509a1</EnumOption>
          <EnumOption>publicCharity509a2</EnumOption>
          <EnumOption>publicCharity509a3SupportingOrg</EnumOption>
          <EnumOption>privateFoundation</EnumOption>
          <EnumOption>privateOperatingFoundation</EnumOption>
        </Enum>
      </Writable>
    </Fact>

    <Fact path="/isPrivateFoundation">
      <Name>Is Private Foundation</Name>
      <Description>Whether organization is a private foundation.</Description>
      <Derived>
        <Any>
          <Equals>
            <Left><Dependency path="/organizationType501c3" /></Left>
            <Right><Enum>privateFoundation</Enum></Right>
          </Equals>
          <Equals>
            <Left><Dependency path="/organizationType501c3" /></Left>
            <Right><Enum>privateOperatingFoundation</Enum></Right>
          </Equals>
        </Any>
      </Derived>
    </Fact>

