          <Dependency path="/npoTotalLiabilitiesEnd" />
        </Subtract>
      </Derived>
    </Fact>

    <!-- ============================================ -->
    <!-- PUBLIC CHARITY SUPPORT TEST                 -->
    <!-- ============================================ -->

    <Fact path="/npoPublicSupport">
      <Name>Public Support</Name>
      <Description>Public support for public charity test.</Description>
      <Derived>
        <Add>
          <Add>
            <Dependency path="/npoContributionsGiftsGrants" />
            <Dependency path="/npoGovernmentGrants" />
          </Add>
          <Dependency path="/npoProgramServiceRevenue" />
        </Add>
      </Derived>
    </Fact>

    <Fact path="/npoPublicSupportPercentage">
      <Name>Public Support Percentage</Name>
      <Description>Public support as percentage of total support.</Description>
      <Derived>
        <Switch>
          <Case>
            <When>
              <GreaterThan>
                <Left><Dependency path="/npoTotalRevenue" /></Left>
                <Right><Dollar>0</Dollar></Right>
              </GreaterThan>
            </When>
            <Then>
              <Multiply>
                <Divide>
                  <Dependency path="/npoPublicSupport" />
                  <Dependency path="/npoTotalRevenue" />
                </Divide>
                <Decimal>100</Decimal>
              </Multiply>
            </Then>
          </Case>
          <Case>
            <When>
              <True />
            </When>
            <Then>
              <Decimal>0</Decimal>
            </Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>

    <Fact path="/npoMeetsPublicSupportTest">
      <Name>Meets Public Support Test</Name>
      <Description>Whether organization meets 33 1/3% public support test.</Description>
      <Derived>
        <GreaterThanOrEqual>
          <Left><Dependency path="/npoPublicSupportPercentage" /></Left>
          <Right><Decimal>33.33</Decimal></Right>
        </GreaterThanOrEqual>
      </Derived>
    </Fact>

    <!-- ============================================ -->
    <!-- UNRELATED BUSINESS INCOME TAX (UBIT)        -->
    <!-- ============================================ -->

    <Fact path="/hasUnrelatedBusinessIncome">
      <Name>Has Unrelated Business Income</Name>
      <Description>Whether organization has unrelated business income.</Description>
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/npoUnrelatedBusinessGrossIncome">
      <Name>Unrelated Business Gross Income</Name>
      <Description>Gross income from unrelated business (Form 990-T).</Description>
      <Export mef="true" />
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/npoUnrelatedBusinessDeductions">
      <Name>Unrelated Business Deductions</Name>
      <Description>Deductions directly connected with unrelated business.</Description>
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/npoUnrelatedBusinessTaxableIncome">
      <Name>Unrelated Business Taxable Income</Name>
      <Description>Unrelated business taxable income (UBTI).</Description>
      <Derived>
        <Max>
          <Dollar>0</Dollar>
          <Subtract>
            <Subtract>
              <Dependency path="/npoUnrelatedBusinessGrossIncome" />
              <Dependency path="/npoUnrelatedBusinessDeductions" />
            </Subtract>
            <!-- $1,000 specific deduction -->
            <Dollar>1000</Dollar>
          </Subtract>
        </Max>
      </Derived>
    </Fact>

    <Fact path="/npoUBIT">
      <Name>Unrelated Business Income Tax</Name>
      <Description>Tax on unrelated business income (21% rate).</Description>
      <Export mef="true" />
      <TaxYear>2025</TaxYear>
      <Derived>
        <Switch>
          <Case>
            <When>
              <Dependency path="/hasUnrelatedBusinessIncome" />
            </When>
            <Then>
              <Round>
                <Multiply>
                  <Dependency path="/npoUnrelatedBusinessTaxableIncome" />
                  <Decimal>0.21</Decimal>
                </Multiply>
              </Round>
            </Then>
          </Case>
          <Case>
            <When>
              <True />
            </When>
            <Then>
              <Dollar>0</Dollar>
            </Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>

    <!-- ============================================ -->
    <!-- FORM REQUIREMENTS                           -->
    <!-- ============================================ -->

    <Fact path="/requiresForm990">
      <Name>Requires Form 990</Name>
      <Description>Whether organization must file Form 990 (gross receipts > $200K or assets > $500K).</Description>
      <Derived>
        <Any>
          <GreaterThan>
            <Left><Dependency path="/npoTotalRevenue" /></Left>
            <Right><Dollar>200000</Dollar></Right>
          </GreaterThan>
          <GreaterThan>
            <Left><Dependency path="/npoTotalAssetsEnd" /></Left>
            <Right><Dollar>500000</Dollar></Right>
          </GreaterThan>
        </Any>
      </Derived>
    </Fact>

    <Fact path="/requiresForm990EZ">
      <Name>Requires Form 990-EZ</Name>
      <Description>Whether organization can file Form 990-EZ (receipts $50K-$200K, assets < $500K).</Description>
      <Derived>
        <All>
          <GreaterThanOrEqual>
            <Left><Dependency path="/npoTotalRevenue" /></Left>
            <Right><Dollar>50000</Dollar></Right>
          </GreaterThanOrEqual>
          <LessThanOrEqual>
            <Left><Dependency path="/npoTotalRevenue" /></Left>
            <Right><Dollar>200000</Dollar></Right>
          </LessThanOrEqual>
          <LessThan>
            <Left><Dependency path="/npoTotalAssetsEnd" /></Left>
            <Right><Dollar>500000</Dollar></Right>
          </LessThan>
        </All>
      </Derived>
    </Fact>

    <Fact path="/requiresForm990N">
      <Name>Requires Form 990-N (e-Postcard)</Name>
      <Description>Whether organization can file Form 990-N (gross receipts normally ≤ $50K).</Description>
      <Derived>
        <LessThan>
          <Left><Dependency path="/npoTotalRevenue" /></Left>
          <Right><Dollar>50000</Dollar></Right>
        </LessThan>
      </Derived>
    </Fact>

    <!-- ============================================ -->
    <!-- FLOW CONTROL                                -->
    <!-- ============================================ -->

    <Fact path="/form990IsDone">
      <Name>Form 990 Is Done</Name>
      <Description>Whether Form 990 is complete.</Description>
      <Derived>
        <All>
          <Dependency path="/isNonProfit" />
          <IsComplete>
            <Dependency path="/organizationName" />
          </IsComplete>
          <IsComplete>
            <Dependency path="/organizationEIN" />
          </IsComplete>
          <IsComplete>
            <Dependency path="/exemptStatusCode" />
          </IsComplete>
        </All>
      </Derived>
    </Fact>

    <Fact path="/pdfIncludeForm990">
      <Name>Include Form 990 in PDF</Name>
      <Description>Whether to include Form 990 in the tax return PDF.</Description>
      <Derived>
        <Dependency path="/isNonProfit" />
      </Derived>
    </Fact>

    <Fact path="/pdfIncludeForm990T">
      <Name>Include Form 990-T in PDF</Name>
      <Description>Whether to include Form 990-T (UBIT) in the tax return PDF.</Description>
      <Derived>
        <All>
          <Dependency path="/isNonProfit" />
          <Dependency path="/hasUnrelatedBusinessIncome" />
          <GreaterThan>
            <Left><Dependency path="/npoUnrelatedBusinessGrossIncome" /></Left>
            <Right><Dollar>1000</Dollar></Right>
          </GreaterThan>
        </All>
      </Derived>
    </Fact>
  </Facts>
</FactDictionaryModule>
