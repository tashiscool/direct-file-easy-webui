<?xml-model href="./FactDictionaryModule.rng"?>
<!-- FinCEN Form 114: Report of Foreign Bank and Financial Accounts (FBAR) -->
<FactDictionaryModule>
  <Facts>
    <Fact path="/hasFBARRequirement">
      <Name>Has FBAR Requirement</Name>
      <Description>Whether taxpayer has FBAR filing requirement.</Description>
      <Export mef="true" />
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/fbarThreshold">
      <Name>FBAR Threshold</Name>
      <Description>FBAR reporting threshold ($10,000).</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Dollar>10000</Dollar>
      </Derived>
    </Fact>

    <Fact path="/numberOfForeignAccounts">
      <Name>Number of Foreign Accounts</Name>
      <Description>Number of foreign accounts to report.</Description>
      <Writable>
        <Int>
          <Limit operation="Min" level="ERROR">
            <IntNode>0</IntNode>
          </Limit>
        </Int>
      </Writable>
    </Fact>

    <Fact path="/aggregateMaxValue">
      <Name>Aggregate Max Value</Name>
      <Description>Aggregate maximum value of all accounts.</Description>
      <Export mef="true" downstreamFacts="true" />
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/formFinCEN114IsDone">
      <Name>FinCEN 114 Is Done</Name>
      <Description>Whether FinCEN 114 is complete.</Description>
      <Derived>
        <Any>
          <Not><Dependency path="/hasFBARRequirement" /></Not>
          <All>
            <Dependency path="/hasFBARRequirement" />
            <IsComplete><Dependency path="/aggregateMaxValue" /></IsComplete>
          </All>
        </Any>
      </Derived>
    </Fact>

    <Fact path="/pdfIncludeFormFinCEN114">
      <Name>Include FinCEN 114 in PDF</Name>
      <Description>Whether to include FinCEN 114.</Description>
      <Derived>
        <GreaterThan>
          <Left><Dependency path="/aggregateMaxValue" /></Left>
          <Right><Dependency path="/fbarThreshold" /></Right>
        </GreaterThan>
      </Derived>
    </Fact>
  </Facts>
</FactDictionaryModule>
