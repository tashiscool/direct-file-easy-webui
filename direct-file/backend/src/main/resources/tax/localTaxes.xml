        <Switch>
          <Case><Equal><Dependency path="/alCityName" /><String>Birmingham</String></Equal><Decimal>0.01</Decimal></Case>
          <Case><Equal><Dependency path="/alCityName" /><String>Gadsden</String></Equal><Decimal>0.02</Decimal></Case>
          <Case><Equal><Dependency path="/alCityName" /><String>Bessemer</String></Equal><Decimal>0.01</Decimal></Case>
          <Default><Decimal>0.01</Decimal></Default>
        </Switch>
      </Derived>
    </Fact>
    <Fact path="/alCityWages">
      <Name>Alabama City Wages</Name>
      <Writable><Dollar /></Writable>
    </Fact>
    <Fact path="/alCityOccupationalTax">
      <Name>Alabama City Occupational Tax</Name>
      <Export mef="true" />
      <Derived>
        <Switch>
          <Case><And><Not><Dependency path="/isALLocalResident" /></Not><Not><Dependency path="/worksInALCity" /></Not></And><Dollar>0</Dollar></Case>
          <Default>
            <Multiply><Dependency path="/alCityWages" /><Dependency path="/alCityTaxRate" /></Multiply>
          </Default>
        </Switch>
      </Derived>
    </Fact>

    <!-- ============ DELAWARE (WILMINGTON) ============ -->
    <Fact path="/isWilmingtonResident">
      <Name>Wilmington DE Resident</Name>
      <Writable><Boolean /></Writable>
    </Fact>
    <Fact path="/worksInWilmington">
      <Name>Works in Wilmington DE</Name>
      <Writable><Boolean /></Writable>
    </Fact>
    <Fact path="/wilmingtonWages">
