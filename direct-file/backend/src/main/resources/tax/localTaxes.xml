        <Switch>
          <Case><And><Not><Dependency path="/isWilmingtonResident" /></Not><Not><Dependency path="/worksInWilmington" /></Not></And><Dollar>0</Dollar></Case>
          <Default>
            <Multiply><Dependency path="/wilmingtonWages" /><Decimal>0.0125</Decimal></Multiply>
          </Default>
        </Switch>
      </Derived>
