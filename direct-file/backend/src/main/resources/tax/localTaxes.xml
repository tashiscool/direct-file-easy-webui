    <!-- ============ OREGON TRANSIT TAXES ============ -->
    <Fact path="/isORTransitResident">
      <Name>Oregon Transit District Resident</Name>
      <Writable><Boolean /></Writable>
    </Fact>
    <Fact path="/orTransitDistrict">
      <Name>Oregon Transit District</Name>
      <Writable><Enum values="TriMet (Portland),Lane Transit District (Eugene),Other" /></Writable>
    </Fact>
    <Fact path="/orTransitTaxRate">
      <Name>Oregon Transit Tax Rate</Name>
      <Derived>
        <Switch>
          <Case><Equal><Dependency path="/orTransitDistrict" /><String>TriMet (Portland)</String></Equal><Decimal>0.0076</Decimal></Case>
          <Case><Equal><Dependency path="/orTransitDistrict" /><String>Lane Transit District (Eugene)</String></Equal><Decimal>0.0075</Decimal></Case>
          <Default><Decimal>0.007</Decimal></Default>
        </Switch>
      </Derived>
    </Fact>
    <Fact path="/orTransitWages">
      <Name>Oregon Transit Taxable Wages</Name>
      <Writable><Dollar /></Writable>
    </Fact>
    <Fact path="/orTransitTax">
      <Name>Oregon Transit Tax</Name>
      <Export mef="true" />
      <Derived>
        <Switch>
          <Case><Not><Dependency path="/isORTransitResident" /></Not><Dollar>0</Dollar></Case>
          <Default>
            <Multiply><Dependency path="/orTransitWages" /><Dependency path="/orTransitTaxRate" /></Multiply>
          </Default>
        </Switch>
      </Derived>
    </Fact>

    <!-- ============ SAN FRANCISCO PAYROLL TAX ============ -->
    <Fact path="/isSFWorker">
      <Name>Works in San Francisco</Name>
      <Description>SF has a Gross Receipts Tax and Homelessness Tax for businesses.</Description>
      <Writable><Boolean /></Writable>
    </Fact>
    <Fact path="/sfPayrollTax">
      <Name>San Francisco Payroll Expense Tax</Name>
      <Description>For employees working 50%+ in SF (employer paid, but impacts compensation).</Description>
      <Export mef="true" />
      <Derived>
        <Dollar>0</Dollar>
      </Derived>
    </Fact>

    <!-- ============ INDIANA LOCAL TAXES ============ -->
    <Fact path="/isIndianaLocalResident">
      <Name>Indiana County Resident</Name>
      <Writable><Boolean /></Writable>
    </Fact>
    <Fact path="/indianaCounty">
      <Name>Indiana County</Name>
      <Writable><String /></Writable>
    </Fact>
    <!-- Indiana county rates vary from 0.5% to 3.38% (Marion County is 2.02%) -->
    <Fact path="/indianaLocalTaxRate">
      <Name>Indiana County Tax Rate</Name>
      <Derived>
        <Decimal>0.0202</Decimal>  <!-- Marion County (Indianapolis) default -->
      </Derived>
    </Fact>
    <Fact path="/indianaLocalTax">
      <Name>Indiana County Income Tax</Name>
      <Export mef="true" />
      <Derived>
        <Switch>
          <Case><Not><Dependency path="/isIndianaLocalResident" /></Not><Dollar>0</Dollar></Case>
          <Default>
            <Multiply><Dependency path="/inTaxableIncome" /><Dependency path="/indianaLocalTaxRate" /></Multiply>
          </Default>
        </Switch>
      </Derived>
    </Fact>

    <!-- ============ TOTAL LOCAL TAXES ============ -->
    <Fact path="/totalLocalIncomeTax">
      <Name>Total Local Income Taxes</Name>
      <Export mef="true" downstreamFacts="true" />
      <Derived>
        <Sum>
          <!-- New York -->
          <Dependency path="/nycIncomeTax" />
          <Dependency path="/yonkersIncomeTax" />
          <!-- Pennsylvania -->
          <Dependency path="/philadelphiaIncomeTax" />
          <Dependency path="/philadelphiaNetProfitsTax" />
          <Dependency path="/paLocalTax" />
          <!-- Ohio -->
          <Dependency path="/ohioCityIncomeTax" />
          <!-- Maryland -->
          <Dependency path="/marylandLocalTax" />
          <!-- Michigan -->
          <Dependency path="/detroitIncomeTax" />
          <Dependency path="/miCityIncomeTax" />
          <!-- Kentucky -->
          <Dependency path="/kentuckyLocalTax" />
          <!-- Indiana -->
          <Dependency path="/indianaLocalTax" />
          <!-- Missouri -->
          <Dependency path="/moCityEarningsTax" />
          <!-- Alabama -->
          <Dependency path="/alCityOccupationalTax" />
          <!-- Delaware -->
          <Dependency path="/wilmingtonWageTax" />
          <!-- West Virginia -->
          <Dependency path="/wvMunicipalTax" />
          <!-- Oregon Transit -->
          <Dependency path="/orTransitTax" />
        </Sum>
      </Derived>
    </Fact>

    <Fact path="/localTaxesIsDone">
      <Derived>
        <Any>
          <Not><Dependency path="/hasLocalIncomeTax" /></Not>
          <IsComplete><Dependency path="/totalLocalIncomeTax" /></IsComplete>
        </Any>
      </Derived>
    </Fact>
  </Facts>
</FactDictionaryModule>
