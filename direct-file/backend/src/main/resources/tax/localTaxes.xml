    <!-- ============ WEST VIRGINIA CITIES ============ -->
    <Fact path="/isWVLocalResident">
      <Name>West Virginia Municipal Tax Resident</Name>
      <Writable><Boolean /></Writable>
    </Fact>
    <Fact path="/wvMunicipality">
      <Name>WV Municipality</Name>
