                  <Dependency path="/seniorBonusDeductionPhaseoutThreshold" />
                </Right>
              </LessThanOrEqual>
            </When>
            <Then>
              <Decimal>1.0</Decimal>
            </Then>
          </Case>
          <Case>
            <When>
              <GreaterThanOrEqual>
                <Left>
                  <Dependency module="taxCalculations" path="/magi" />
                </Left>
                <Right>
                  <Add>
                    <Dependency path="/seniorBonusDeductionPhaseoutThreshold" />
                    <Dependency path="/seniorBonusPhaseoutRange" />
