              <Decimal>0.0</Decimal>
            </Then>
          </Case>
          <Case>
            <When>
              <True />
            </When>
            <Then>
              <Subtract>
                <Minuend>
                  <Decimal>1.0</Decimal>
                </Minuend>
                <Subtrahends>
                  <Divide>
                    <Dividend>
                      <Subtract>
                        <Minuend>
                          <Dependency module="taxCalculations" path="/magi" />
                        </Minuend>
                        <Subtrahends>
                          <Dependency path="/seniorBonusDeductionPhaseoutThreshold" />
                        </Subtrahends>
                      </Subtract>
                    </Dividend>
                    <Divisors>
                      <Dependency path="/seniorBonusPhaseoutRange" />
                    </Divisors>
                  </Divide>
                </Subtrahends>
              </Subtract>
            </Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>

    <Fact path="/primaryFilerIsSenior">
      <Name>Primary Filer Is Senior</Name>
      <Description>Whether the primary filer is age 65 or older.</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Dependency module="filers" path="/primaryFiler/age65OrOlder" />
      </Derived>
    </Fact>

    <Fact path="/secondaryFilerIsSenior">
      <Name>Secondary Filer Is Senior</Name>
      <Description>Whether the secondary filer (spouse) is age 65 or older.</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <All>
          <Dependency module="filingStatus" path="/isFilingStatusMFJ" />
          <Dependency module="filers" path="/secondaryFiler/age65OrOlder" />
        </All>
      </Derived>
    </Fact>

    <Fact path="/eligibleSeniorsCount">
      <Name>Eligible Seniors Count</Name>
      <Description>Number of filers age 65 or older eligible for the senior bonus deduction.</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Add>
          <Switch>
            <Case>
              <When>
                <Dependency path="/primaryFilerIsSenior" />
              </When>
              <Then>
                <Int>1</Int>
              </Then>
            </Case>
            <Case>
              <When>
                <True />
              </When>
              <Then>
                <Int>0</Int>
              </Then>
            </Case>
          </Switch>
          <Switch>
            <Case>
              <When>
                <Dependency path="/secondaryFilerIsSenior" />
              </When>
              <Then>
                <Int>1</Int>
              </Then>
            </Case>
            <Case>
              <When>
                <True />
              </When>
              <Then>
                <Int>0</Int>
              </Then>
            </Case>
          </Switch>
        </Add>
      </Derived>
    </Fact>

    <Fact path="/hasSeniorBonusEligibility">
      <Name>Has Senior Bonus Eligibility</Name>
      <Description>Whether any filer qualifies for the senior bonus deduction.</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <GreaterThan>
          <Left>
            <Dependency path="/eligibleSeniorsCount" />
          </Left>
          <Right>
            <Int>0</Int>
          </Right>
        </GreaterThan>
      </Derived>
    </Fact>

    <Fact path="/seniorBonusBeforePhaseout">
      <Name>Senior Bonus Before Phase-out</Name>
      <Description>Total senior bonus deduction before applying phase-out.</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Multiply>
          <Dependency path="/eligibleSeniorsCount" />
          <Dependency path="/seniorBonusDeductionAmount" />
        </Multiply>
      </Derived>
    </Fact>

    <Fact path="/totalSeniorBonusDeduction">
      <Name>Total Senior Bonus Deduction</Name>
      <Description>Total senior bonus deduction based on number of eligible seniors, after phase-out.
        Schedule 1-A Part IV Line 16.</Description>
      <Export mef="true" />
      <TaxYear>2025</TaxYear>
      <Derived>
        <Round>
          <Multiply>
            <Dependency path="/seniorBonusBeforePhaseout" />
            <Dependency path="/seniorBonusPhaseoutMultiplier" />
          </Multiply>
        </Round>
      </Derived>
    </Fact>

    <!-- ============================================ -->
    <!-- SCHEDULE 1-A TOTAL                          -->
    <!-- ============================================ -->

    <Fact path="/totalSchedule1ADeductions">
      <Name>Total Schedule 1-A Additional Deductions</Name>
      <Description>Sum of all OBBBA additional deductions (overtime, tips, auto loan interest, senior bonus).
        This amount is reported on Schedule 1-A Line 17 and transfers to Schedule 1.</Description>
      <Export mef="true" downstreamFacts="true" />
      <TaxYear>2025</TaxYear>
      <Derived>
        <Round>
          <Add>
            <Dependency path="/overtimeDeductionAmount" />
            <Dependency path="/tipDeductionAmount" />
            <Dependency path="/autoLoanInterestDeductionAmount" />
            <Dependency path="/totalSeniorBonusDeduction" />
          </Add>
        </Round>
      </Derived>
    </Fact>

    <Fact path="/hasSchedule1ADeductions">
      <Name>Has Schedule 1-A Deductions</Name>
      <Description>Whether the taxpayer has any Schedule 1-A additional deductions to claim.</Description>
      <Export downstreamFacts="true" />
      <TaxYear>2025</TaxYear>
      <Derived>
        <GreaterThan>
          <Left>
            <Dependency path="/totalSchedule1ADeductions" />
          </Left>
          <Right>
            <Dollar>0</Dollar>
          </Right>
        </GreaterThan>
      </Derived>
    </Fact>

    <Fact path="/noObbbaDeductions">
      <Name>No OBBBA Deductions</Name>
      <Description>Whether the taxpayer has no OBBBA deductions to claim (for display purposes).</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <All>
          <Not>
            <Dependency path="/hasQualifiedOvertime" />
          </Not>
          <Not>
            <Dependency path="/hasQualifiedTips" />
          </Not>
          <Any>
            <Not>
              <Dependency path="/hasQualifiedAutoLoanInterest" />
            </Not>
            <Not>
              <Dependency path="/vehicleIsDomesticManufacture" />
            </Not>
          </Any>
          <Not>
            <Dependency path="/hasSeniorBonusEligibility" />
          </Not>
        </All>
      </Derived>
    </Fact>

    <Fact path="/pdfIncludeSchedule1A">
      <Name>Include Schedule 1-A in tax return PDF</Name>
      <Description>Whether the tax return PDF should include Schedule 1-A.</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Dependency path="/hasSchedule1ADeductions" />
      </Derived>
    </Fact>
  </Facts>
</FactDictionaryModule>
