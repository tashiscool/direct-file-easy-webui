<?xml-model href="./FactDictionaryModule.rng"?>
<!-- Schedule 1-A: Additional Deductions (OBBBA 2025-2028) -->
<FactDictionaryModule>
  <Facts>
    <!-- ============================================ -->
    <!-- FLOW CONTROL FACTS                          -->
    <!-- ============================================ -->

    <Fact path="/hasQualifiedOvertime">
      <Name>Has Qualified Overtime</Name>
      <Description>Whether the taxpayer has qualified overtime income to claim as a deduction.</Description>
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/hasQualifiedTips">
      <Name>Has Qualified Tips</Name>
      <Description>Whether the taxpayer has qualified tip income to claim as a deduction.</Description>
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/hasQualifiedAutoLoanInterest">
      <Name>Has Qualified Auto Loan Interest</Name>
      <Description>Whether the taxpayer has qualified auto loan interest to claim as a deduction.</Description>
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/vehicleIsDomesticManufacture">
      <Name>Vehicle Is Domestic Manufacture</Name>
      <Description>Whether the vehicle was manufactured or assembled in the United States.</Description>
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/vehicleMake">
      <Name>Vehicle Make</Name>
      <Description>The manufacturer/make of the qualified vehicle (e.g., Ford, Chevrolet, Tesla).</Description>
      <Writable>
        <String />
      </Writable>
    </Fact>

    <Fact path="/vehicleModel">
      <Name>Vehicle Model</Name>
      <Description>The model of the qualified vehicle (e.g., F-150, Silverado, Model 3).</Description>
      <Writable>
        <String />
      </Writable>
    </Fact>

    <Fact path="/vehicleYear">
      <Name>Vehicle Year</Name>
      <Description>The model year of the qualified vehicle.</Description>
      <Writable>
        <String />
      </Writable>
    </Fact>

    <Fact path="/obbbaDeductionsIsDone">
      <Name>OBBBA Deductions Section Complete</Name>
      <Description>Whether the OBBBA deductions section has been completed by the user.</Description>
      <Derived>
        <All>
          <!-- User has answered the overtime question -->
          <IsComplete>
            <Dependency path="/hasQualifiedOvertime" />
          </IsComplete>
          <!-- If they have overtime, they've entered the amount -->
          <Any>
            <Not>
              <Dependency path="/hasQualifiedOvertime" />
            </Not>
            <IsComplete>
              <Dependency path="/qualifiedOvertimeIncome" />
            </IsComplete>
          </Any>
          <!-- User has answered the tips question -->
          <IsComplete>
            <Dependency path="/hasQualifiedTips" />
          </IsComplete>
          <!-- If they have tips, they've entered the amount -->
          <Any>
            <Not>
              <Dependency path="/hasQualifiedTips" />
            </Not>
            <IsComplete>
              <Dependency path="/qualifiedTipIncome" />
            </IsComplete>
          </Any>
          <!-- User has answered the auto loan question -->
          <IsComplete>
            <Dependency path="/hasQualifiedAutoLoanInterest" />
          </IsComplete>
          <!-- If they have auto loan interest, they've completed the vehicle info -->
          <Any>
            <Not>
              <Dependency path="/hasQualifiedAutoLoanInterest" />
            </Not>
            <All>
              <IsComplete>
                <Dependency path="/vehicleIsDomesticManufacture" />
              </IsComplete>
              <Any>
                <Not>
                  <Dependency path="/vehicleIsDomesticManufacture" />
                </Not>
                <IsComplete>
                  <Dependency path="/qualifiedAutoLoanInterest" />
                </IsComplete>
              </Any>
            </All>
          </Any>
        </All>
      </Derived>
    </Fact>

    <Fact path="/obbbaPhaseOutApplies">
      <Name>OBBBA Phase-out Applies</Name>
      <Description>Whether income phase-out applies to any of the OBBBA deductions.</Description>
      <Derived>
        <Any>
          <!-- Overtime phase-out applies if MAGI > threshold and has overtime -->
          <All>
            <Dependency path="/hasQualifiedOvertime" />
            <GreaterThan>
              <Left>
                <Dependency module="taxCalculations" path="/magi" />
              </Left>
              <Right>
                <Dependency path="/overtimeDeductionPhaseoutThreshold" />
              </Right>
            </GreaterThan>
          </All>
          <!-- Tip phase-out applies if MAGI > threshold and has tips -->
          <All>
            <Dependency path="/hasQualifiedTips" />
            <GreaterThan>
              <Left>
                <Dependency module="taxCalculations" path="/magi" />
              </Left>
              <Right>
                <Dependency path="/tipDeductionPhaseoutThreshold" />
              </Right>
            </GreaterThan>
          </All>
          <!-- Auto loan phase-out applies if MAGI > threshold and has auto loan -->
          <All>
            <Dependency path="/hasQualifiedAutoLoanInterest" />
            <Dependency path="/vehicleIsDomesticManufacture" />
            <GreaterThan>
              <Left>
                <Dependency module="taxCalculations" path="/magi" />
              </Left>
              <Right>
                <Dependency path="/autoLoanInterestPhaseoutThreshold" />
              </Right>
            </GreaterThan>
          </All>
          <!-- Senior bonus phase-out applies if MAGI > threshold and has seniors -->
          <All>
            <Dependency path="/hasSeniorBonusEligibility" />
            <GreaterThan>
              <Left>
                <Dependency module="taxCalculations" path="/magi" />
              </Left>
              <Right>
                <Dependency path="/seniorBonusDeductionPhaseoutThreshold" />
              </Right>
            </GreaterThan>
          </All>
        </Any>
      </Derived>
    </Fact>

    <!-- ============================================ -->
    <!-- PART I: QUALIFIED OVERTIME INCOME EXEMPTION -->
    <!-- ============================================ -->

    <Fact path="/qualifiedOvertimeIncome">
      <Name>Qualified Overtime Income</Name>
      <Description>The premium portion of overtime pay (e.g., the "half" in time-and-a-half) that qualifies
        for the deduction under OBBBA. User must enter the qualified portion, not total overtime pay.</Description>
      <TaxYear>2025</TaxYear>
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/overtimeDeductionCap">
      <Name>Overtime Deduction Cap</Name>
      <Description>Maximum deductible qualified overtime income based on filing status.
        Single/HOH/MFS: $12,500, MFJ: $25,000</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Switch>
          <Case>
            <When>
              <Dependency module="filingStatus" path="/isFilingStatusMFJ" />
            </When>
            <Then>
              <Dollar>25000</Dollar>
            </Then>
          </Case>
          <Case>
            <When>
              <True />
            </When>
            <Then>
              <Dollar>12500</Dollar>
            </Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>

    <Fact path="/overtimeDeductionPhaseoutThreshold">
      <Name>Overtime Deduction Phase-out Threshold</Name>
      <Description>MAGI threshold at which overtime deduction begins to phase out.
        Single: $150,000, MFJ: $300,000</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Switch>
          <Case>
            <When>
              <Dependency module="filingStatus" path="/isFilingStatusMFJ" />
            </When>
            <Then>
              <Dollar>300000</Dollar>
            </Then>
          </Case>
          <Case>
            <When>
              <True />
            </When>
            <Then>
              <Dollar>150000</Dollar>
            </Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>

    <Fact path="/overtimeDeductionPhaseoutRange">
      <Name>Overtime Deduction Phase-out Range</Name>
      <Description>The income range over which the overtime deduction phases out completely ($50,000).</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Dollar>50000</Dollar>
      </Derived>
    </Fact>

    <Fact path="/overtimeDeductionPhaseoutMultiplier">
      <Name>Overtime Deduction Phase-out Multiplier</Name>
      <Description>The percentage of overtime deduction remaining after phase-out (0-1).</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Switch>
          <Case>
            <!-- If MAGI is at or below threshold, no phase-out -->
            <When>
              <LessThanOrEqual>
                <Left>
                  <Dependency module="taxCalculations" path="/magi" />
                </Left>
                <Right>
                  <Dependency path="/overtimeDeductionPhaseoutThreshold" />
                </Right>
              </LessThanOrEqual>
            </When>
            <Then>
              <Decimal>1.0</Decimal>
            </Then>
          </Case>
          <Case>
            <!-- If MAGI exceeds threshold + range, fully phased out -->
            <When>
              <GreaterThanOrEqual>
                <Left>
                  <Dependency module="taxCalculations" path="/magi" />
                </Left>
                <Right>
                  <Add>
                    <Dependency path="/overtimeDeductionPhaseoutThreshold" />
                    <Dependency path="/overtimeDeductionPhaseoutRange" />
                  </Add>
                </Right>
              </GreaterThanOrEqual>
            </When>
            <Then>
              <Decimal>0.0</Decimal>
            </Then>
          </Case>
          <Case>
            <!-- Partial phase-out -->
            <When>
              <True />
            </When>
            <Then>
              <Subtract>
                <Minuend>
                  <Decimal>1.0</Decimal>
                </Minuend>
                <Subtrahends>
                  <Divide>
                    <Dividend>
                      <Subtract>
                        <Minuend>
                          <Dependency module="taxCalculations" path="/magi" />
                        </Minuend>
                        <Subtrahends>
                          <Dependency path="/overtimeDeductionPhaseoutThreshold" />
                        </Subtrahends>
                      </Subtract>
                    </Dividend>
                    <Divisors>
                      <Dependency path="/overtimeDeductionPhaseoutRange" />
                    </Divisors>
                  </Divide>
                </Subtrahends>
              </Subtract>
            </Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>

    <Fact path="/overtimeDeductionBeforePhaseout">
      <Name>Overtime Deduction Before Phase-out</Name>
      <Description>The overtime deduction amount before applying phase-out reduction.</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <LesserOf>
          <Switch>
            <Case>
              <When>
                <All>
                  <Dependency path="/hasQualifiedOvertime" />
                  <IsComplete>
                    <Dependency path="/qualifiedOvertimeIncome" />
                  </IsComplete>
                </All>
              </When>
              <Then>
                <Dependency path="/qualifiedOvertimeIncome" />
              </Then>
            </Case>
            <Case>
              <When>
                <True />
              </When>
              <Then>
                <Dollar>0</Dollar>
              </Then>
            </Case>
          </Switch>
          <Dependency path="/overtimeDeductionCap" />
        </LesserOf>
      </Derived>
    </Fact>

    <Fact path="/overtimeDeductionAmount">
      <Name>Overtime Deduction Amount</Name>
      <Description>The deductible amount of qualified overtime income after applying cap and phase-out.
        Schedule 1-A Part I Line 4.</Description>
      <Export mef="true" />
      <TaxYear>2025</TaxYear>
      <Derived>
        <Round>
          <Multiply>
            <Dependency path="/overtimeDeductionBeforePhaseout" />
            <Dependency path="/overtimeDeductionPhaseoutMultiplier" />
          </Multiply>
        </Round>
      </Derived>
    </Fact>

