<?xml-model href="./FactDictionaryModule.rng"?>
<!-- Schedule B: Interest and Ordinary Dividends -->
<FactDictionaryModule>
  <Facts>
    <!-- ============================================ -->
    <!-- DIVIDEND INCOME (Part II)                   -->
    <!-- ============================================ -->

    <Fact path="/hasDividendIncome">
      <Name>Has Dividend Income</Name>
      <Description>Whether the taxpayer received dividend income.</Description>
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/ordinaryDividends">
      <Name>Ordinary Dividends</Name>
      <Description>Total ordinary dividends received (Box 1a of Form 1099-DIV).</Description>
      <Export mef="true" />
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/qualifiedDividends">
      <Name>Qualified Dividends</Name>
      <Description>Qualified dividends eligible for lower tax rates (Box 1b of Form 1099-DIV).</Description>
      <Export mef="true" />
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/totalOrdinaryDividends">
      <Name>Total Ordinary Dividends</Name>
      <Description>Total ordinary dividends for Form 1040 Line 3b.</Description>
      <Export mef="true" downstreamFacts="true" />
      <TaxYear>2025</TaxYear>
      <Derived>
        <Switch>
          <Case>
            <When>
              <All>
                <Dependency path="/hasDividendIncome" />
                <IsComplete>
                  <Dependency path="/ordinaryDividends" />
                </IsComplete>
              </All>
            </When>
            <Then>
              <Dependency path="/ordinaryDividends" />
            </Then>
          </Case>
          <Case>
            <When>
              <True />
            </When>
            <Then>
              <Dollar>0</Dollar>
            </Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>

    <Fact path="/totalQualifiedDividends">
      <Name>Total Qualified Dividends</Name>
      <Description>Total qualified dividends for Form 1040 Line 3a.</Description>
      <Export mef="true" downstreamFacts="true" />
      <TaxYear>2025</TaxYear>
      <Derived>
        <Switch>
          <Case>
            <When>
              <All>
                <Dependency path="/hasDividendIncome" />
                <IsComplete>
                  <Dependency path="/qualifiedDividends" />
                </IsComplete>
              </All>
            </When>
            <Then>
              <Dependency path="/qualifiedDividends" />
            </Then>
          </Case>
          <Case>
            <When>
              <True />
            </When>
            <Then>
              <Dollar>0</Dollar>
            </Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>

    <!-- ============================================ -->
    <!-- CAPITAL GAIN DISTRIBUTIONS                  -->
    <!-- ============================================ -->

    <Fact path="/capitalGainDistributions">
      <Name>Capital Gain Distributions</Name>
      <Description>Capital gain distributions from mutual funds (Box 2a of Form 1099-DIV).</Description>
      <Export mef="true" />
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/section1250Gain">
      <Name>Section 1250 Gain</Name>
      <Description>Unrecaptured Section 1250 gain (Box 2b of Form 1099-DIV).</Description>
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/section1202Gain">
      <Name>Section 1202 Gain</Name>
      <Description>Section 1202 gain (Box 2c of Form 1099-DIV).</Description>
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/collectiblesGain">
      <Name>Collectibles Gain</Name>
      <Description>Collectibles (28%) gain (Box 2d of Form 1099-DIV).</Description>
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <!-- ============================================ -->
    <!-- FOREIGN DIVIDENDS AND TAXES                 -->
    <!-- ============================================ -->

    <Fact path="/foreignDividends">
      <Name>Foreign Dividends</Name>
      <Description>Dividends from foreign sources.</Description>
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/foreignTaxPaidOnDividends">
      <Name>Foreign Tax Paid on Dividends</Name>
      <Description>Foreign tax paid on dividend income (Box 7 of Form 1099-DIV).</Description>
      <Export mef="true" />
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <!-- ============================================ -->
    <!-- SCHEDULE B THRESHOLD AND REQUIREMENTS       -->
    <!-- ============================================ -->

    <Fact path="/scheduleBRequired">
      <Name>Schedule B Required</Name>
      <Description>Whether Schedule B is required (interest or dividends exceed $1,500).</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Any>
          <GreaterThan>
            <Left>
              <Dependency module="interest" path="/totalTaxableInterest" />
            </Left>
            <Right>
              <Dollar>1500</Dollar>
            </Right>
          </GreaterThan>
          <GreaterThan>
            <Left>
              <Dependency path="/totalOrdinaryDividends" />
            </Left>
            <Right>
              <Dollar>1500</Dollar>
            </Right>
          </GreaterThan>
        </Any>
      </Derived>
    </Fact>

    <!-- ============================================ -->
    <!-- FOREIGN ACCOUNTS (Part III)                 -->
    <!-- ============================================ -->

    <Fact path="/hasForeignAccounts">
      <Name>Has Foreign Accounts</Name>
      <Description>Whether the taxpayer has a financial interest in or signature authority over a foreign account.</Description>
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/foreignAccountsValue">
      <Name>Foreign Accounts Value</Name>
      <Description>Maximum value of all foreign financial accounts during the year.</Description>
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/fbarRequired">
      <Name>FBAR Required</Name>
      <Description>Whether FBAR (FinCEN Form 114) filing is required (accounts exceed $10,000).</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <All>
          <Dependency path="/hasForeignAccounts" />
          <GreaterThan>
            <Left>
              <Dependency path="/foreignAccountsValue" />
            </Left>
            <Right>
              <Dollar>10000</Dollar>
            </Right>
          </GreaterThan>
        </All>
      </Derived>
    </Fact>

    <Fact path="/foreignCountries">
      <Name>Foreign Countries</Name>
      <Description>Countries where foreign accounts are located.</Description>
      <Writable>
        <String />
      </Writable>
    </Fact>

    <!-- ============================================ -->
    <!-- QUALIFIED DIVIDEND TAX CALCULATION          -->
    <!-- ============================================ -->

    <Fact path="/qualifiedDividendTaxRate0Threshold">
      <Name>Qualified Dividend 0% Tax Rate Threshold</Name>
      <Description>Taxable income threshold for 0% qualified dividend tax rate.</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Switch>
          <Case>
            <When>
              <Dependency module="filingStatus" path="/isFilingStatusMFJ" />
            </When>
            <Then>
              <Dollar>96700</Dollar>
            </Then>
          </Case>
          <Case>
            <When>
              <Dependency module="filingStatus" path="/isFilingStatusHOH" />
            </When>
            <Then>
              <Dollar>64750</Dollar>
            </Then>
          </Case>
          <Case>
            <When>
              <True />
            </When>
            <Then>
              <Dollar>48350</Dollar>
            </Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>

    <Fact path="/qualifiedDividendTaxRate15Threshold">
      <Name>Qualified Dividend 15% Tax Rate Threshold</Name>
      <Description>Taxable income threshold for 15% qualified dividend tax rate.</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Switch>
          <Case>
            <When>
              <Dependency module="filingStatus" path="/isFilingStatusMFJ" />
            </When>
            <Then>
              <Dollar>600050</Dollar>
            </Then>
          </Case>
          <Case>
            <When>
              <Dependency module="filingStatus" path="/isFilingStatusHOH" />
            </When>
            <Then>
              <Dollar>566700</Dollar>
            </Then>
          </Case>
          <Case>
            <When>
              <True />
            </When>
            <Then>
              <Dollar>533400</Dollar>
            </Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>

    <!-- ============================================ -->
    <!-- FLOW CONTROL                                -->
    <!-- ============================================ -->

    <Fact path="/scheduleBIsDone">
      <Name>Schedule B Is Done</Name>
      <Description>Whether the dividend income section has been completed.</Description>
      <Derived>
        <Any>
          <!-- User has no dividend income -->
          <Not>
            <Dependency path="/hasDividendIncome" />
          </Not>
          <!-- User has dividend income and has entered amounts -->
          <All>
            <Dependency path="/hasDividendIncome" />
            <IsComplete>
              <Dependency path="/ordinaryDividends" />
            </IsComplete>
          </All>
        </Any>
      </Derived>
    </Fact>

    <Fact path="/pdfIncludeScheduleB">
      <Name>Include Schedule B in PDF</Name>
      <Description>Whether to include Schedule B in the tax return PDF.</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Dependency path="/scheduleBRequired" />
      </Derived>
    </Fact>
  </Facts>
</FactDictionaryModule>
