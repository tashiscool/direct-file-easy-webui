      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/businessDepletion">
      <Name>Depletion</Name>
      <Description>Depletion expense for natural resources.</Description>
      <Writable>
