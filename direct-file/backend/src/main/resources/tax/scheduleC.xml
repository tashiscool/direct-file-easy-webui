          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/businessDepreciation">
      <Name>Depreciation and Section 179</Name>
      <Description>Depreciation and Section 179 expense deduction.</Description>
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/businessEmployeeBenefit">
      <Name>Employee Benefit Programs</Name>
      <Description>Employee benefit programs other than pension.</Description>
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
