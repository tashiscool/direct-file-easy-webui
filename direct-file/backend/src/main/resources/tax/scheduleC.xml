      </Writable>
    </Fact>

    <Fact path="/businessInsurance">
      <Name>Insurance (Non-Health)</Name>
      <Description>Business insurance (not health insurance).</Description>
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/businessInterestMortgage">
      <Name>Interest - Mortgage</Name>
      <Description>Mortgage interest paid to banks.</Description>
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/businessInterestOther">
      <Name>Interest - Other</Name>
      <Description>Other business interest expense.</Description>
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
