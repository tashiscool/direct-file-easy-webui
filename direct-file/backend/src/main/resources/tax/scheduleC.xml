<?xml-model href="./FactDictionaryModule.rng"?>
<!-- Schedule C: Profit or Loss from Business (Sole Proprietorship) -->
<FactDictionaryModule>
  <Facts>
    <!-- ============================================ -->
    <!-- BUSINESS INFORMATION                        -->
    <!-- ============================================ -->

    <Fact path="/hasSelfEmploymentIncome">
      <Name>Has Self-Employment Income</Name>
      <Description>Whether the taxpayer has self-employment or business income.</Description>
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/businessName">
      <Name>Business Name</Name>
      <Description>Name of the sole proprietorship or business.</Description>
      <Writable>
        <String />
      </Writable>
    </Fact>

    <Fact path="/businessEIN">
      <Name>Business EIN</Name>
      <Description>Employer Identification Number (if applicable).</Description>
      <Writable>
        <String />
      </Writable>
    </Fact>

    <Fact path="/businessAddress">
      <Name>Business Address</Name>
      <Description>Principal business address.</Description>
      <Writable>
        <String />
      </Writable>
    </Fact>

    <Fact path="/businessActivityCode">
      <Name>Business Activity Code</Name>
      <Description>Principal business or profession activity code (NAICS).</Description>
      <Writable>
        <String />
      </Writable>
    </Fact>

    <Fact path="/businessAccountingMethod">
      <Name>Accounting Method</Name>
      <Description>Accounting method: cash, accrual, or other.</Description>
      <Writable>
        <Enum>
          <EnumOption>cash</EnumOption>
          <EnumOption>accrual</EnumOption>
          <EnumOption>other</EnumOption>
        </Enum>
      </Writable>
    </Fact>

    <Fact path="/materiallyParticipated">
      <Name>Materially Participated</Name>
      <Description>Whether taxpayer materially participated in business operations.</Description>
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <!-- ============================================ -->
    <!-- GROSS INCOME                                -->
    <!-- ============================================ -->

    <Fact path="/businessGrossReceipts">
      <Name>Gross Receipts or Sales</Name>
      <Description>Gross receipts or sales before returns and allowances.</Description>
      <Export mef="true" />
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/businessReturnsAllowances">
      <Name>Returns and Allowances</Name>
      <Description>Returns and allowances from gross receipts.</Description>
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/businessNetReceipts">
      <Name>Net Receipts</Name>
      <Description>Gross receipts minus returns and allowances.</Description>
      <Derived>
        <Subtract>
          <Dependency path="/businessGrossReceipts" />
          <Dependency path="/businessReturnsAllowances" />
        </Subtract>
      </Derived>
    </Fact>

    <Fact path="/businessCostOfGoodsSold">
      <Name>Cost of Goods Sold</Name>
      <Description>Cost of goods sold (Schedule C, Part III).</Description>
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/businessGrossProfit">
      <Name>Gross Profit</Name>
      <Description>Net receipts minus cost of goods sold.</Description>
      <Derived>
        <Subtract>
          <Dependency path="/businessNetReceipts" />
          <Dependency path="/businessCostOfGoodsSold" />
        </Subtract>
      </Derived>
    </Fact>

    <Fact path="/businessOtherIncome">
      <Name>Other Business Income</Name>
      <Description>Other income including federal and state gas tax credit.</Description>
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/businessGrossIncome">
      <Name>Gross Business Income</Name>
      <Description>Gross profit plus other income.</Description>
      <Derived>
        <Add>
          <Dependency path="/businessGrossProfit" />
          <Dependency path="/businessOtherIncome" />
        </Add>
      </Derived>
    </Fact>

    <!-- ============================================ -->
    <!-- BUSINESS EXPENSES                           -->
    <!-- ============================================ -->

    <Fact path="/businessAdvertising">
      <Name>Advertising</Name>
      <Description>Advertising and marketing expenses.</Description>
      <Writable>
