<?xml-model href="./FactDictionaryModule.rng"?>
<!-- Schedule D (Form 1041): Capital Gains and Losses -->
<FactDictionaryModule>
  <Facts>
    <!-- ============================================ -->
    <!-- PART I: SHORT-TERM CAPITAL GAINS/LOSSES     -->
    <!-- ============================================ -->

    <Fact path="/shortTermGainsFromForm8949">
      <Name>Short-Term Gains from Form 8949</Name>
      <Description>Short-term gains from Form 8949, Part I (Line 1a).</Description>
      <Writable>
        <Dollar />
      </Writable>
    </Fact>

    <Fact path="/shortTermGainsFromScheduleK1">
      <Name>Short-Term Gains from Schedule K-1</Name>
      <Description>Short-term gains from partnerships, S corps, etc. (Line 4).</Description>
      <Writable>
        <Dollar />
      </Writable>
    </Fact>

    <Fact path="/shortTermCapLossCarryover">
      <Name>Short-Term Capital Loss Carryover</Name>
      <Description>Short-term capital loss carryover (Line 5).</Description>
      <Writable>
        <Dollar>
          <Limit operation="Max" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/netShortTermCapGainLoss1041">
      <Name>Net Short-Term Capital Gain (Loss)</Name>
      <Description>Net short-term capital gain or loss (Line 6).</Description>
      <Export mef="true" />
      <Derived>
        <Add>
          <Add>
            <Dependency path="/shortTermGainsFromForm8949" />
            <Dependency path="/shortTermGainsFromScheduleK1" />
          </Add>
          <Dependency path="/shortTermCapLossCarryover" />
        </Add>
      </Derived>
    </Fact>

    <!-- ============================================ -->
    <!-- PART II: LONG-TERM CAPITAL GAINS/LOSSES     -->
    <!-- ============================================ -->

    <Fact path="/longTermGainsFromForm8949">
      <Name>Long-Term Gains from Form 8949</Name>
      <Description>Long-term gains from Form 8949, Part II (Line 7).</Description>
      <Writable>
        <Dollar />
      </Writable>
    </Fact>

    <Fact path="/longTermGainsFromScheduleK1">
      <Name>Long-Term Gains from Schedule K-1</Name>
      <Description>Long-term gains from partnerships, S corps, etc. (Line 10).</Description>
      <Writable>
        <Dollar />
      </Writable>
    </Fact>

    <Fact path="/capitalGainDistributions1041">
      <Name>Capital Gain Distributions</Name>
      <Description>Capital gain distributions (Line 11).</Description>
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/longTermCapLossCarryover1041">
      <Name>Long-Term Capital Loss Carryover</Name>
      <Description>Long-term capital loss carryover (Line 12).</Description>
      <Writable>
        <Dollar>
          <Limit operation="Max" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/netLongTermCapGainLoss1041">
      <Name>Net Long-Term Capital Gain (Loss)</Name>
      <Description>Net long-term capital gain or loss (Line 13).</Description>
      <Export mef="true" />
      <Derived>
        <Add>
          <Add>
            <Add>
              <Dependency path="/longTermGainsFromForm8949" />
              <Dependency path="/longTermGainsFromScheduleK1" />
            </Add>
            <Dependency path="/capitalGainDistributions1041" />
          </Add>
          <Dependency path="/longTermCapLossCarryover1041" />
        </Add>
      </Derived>
    </Fact>

    <!-- ============================================ -->
    <!-- PART III: SUMMARY                           -->
    <!-- ============================================ -->

    <Fact path="/totalCapGainLoss1041">
      <Name>Total Capital Gain (Loss)</Name>
      <Description>Total capital gain or loss (Line 14).</Description>
      <Export mef="true" />
      <Derived>
        <Add>
          <Dependency path="/netShortTermCapGainLoss1041" />
          <Dependency path="/netLongTermCapGainLoss1041" />
        </Add>
      </Derived>
    </Fact>

    <Fact path="/hasNetCapGain1041">
      <Name>Has Net Capital Gain</Name>
      <Description>Whether there is a net capital gain.</Description>
      <Derived>
        <GreaterThan>
          <Left><Dependency path="/totalCapGainLoss1041" /></Left>
          <Right><Dollar>0</Dollar></Right>
        </GreaterThan>
      </Derived>
    </Fact>

    <Fact path="/capLossAllowedForYear1041">
      <Name>Capital Loss Allowed</Name>
      <Description>Capital loss allowed for the tax year ($3,000 limit).</Description>
      <Derived>
        <Max>
          <Multiply>
            <Dollar>3000</Dollar>
            <Int>-1</Int>
          </Multiply>
          <Dependency path="/totalCapGainLoss1041" />
        </Max>
      </Derived>
    </Fact>

    <Fact path="/capLossCarryoverToNextYear">
      <Name>Capital Loss Carryover to Next Year</Name>
      <Description>Capital loss carryover to next year.</Description>
      <Derived>
        <Switch>
          <Case>
            <When>
              <LessThan>
                <Left><Dependency path="/totalCapGainLoss1041" /></Left>
                <Right><Multiply><Dollar>3000</Dollar><Int>-1</Int></Multiply></Right>
              </LessThan>
            </When>
            <Then>
              <Subtract>
                <Dependency path="/totalCapGainLoss1041" />
                <Multiply><Dollar>3000</Dollar><Int>-1</Int></Multiply>
              </Subtract>
            </Then>
          </Case>
          <Case>
            <When><True /></When>
            <Then><Dollar>0</Dollar></Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>

    <!-- ============================================ -->
    <!-- 28% RATE GAIN AND SECTION 1250 GAIN         -->
    <!-- ============================================ -->

    <Fact path="/collectiblesGain1041">
      <Name>Collectibles Gain</Name>
      <Description>28% rate gain (collectibles and section 1202).</Description>
      <Writable>
        <Dollar />
      </Writable>
    </Fact>

    <Fact path="/unrecapturedSec1250Gain1041">
      <Name>Unrecaptured Section 1250 Gain</Name>
      <Description>Unrecaptured section 1250 gain.</Description>
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <!-- ============================================ -->
    <!-- TAX COMPUTATION WORKSHEET                   -->
    <!-- ============================================ -->

    <Fact path="/qualifiedDividends1041">
      <Name>Qualified Dividends</Name>
      <Description>Qualified dividends for tax computation.</Description>
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/netCapGainForTaxComp">
      <Name>Net Capital Gain for Tax Computation</Name>
      <Description>Net capital gain for tax computation worksheet.</Description>
      <Derived>
        <Max>
          <Dollar>0</Dollar>
          <Dependency path="/netLongTermCapGainLoss1041" />
        </Max>
      </Derived>
    </Fact>

    <Fact path="/qualifiedDividendsAndNetCapGain">
      <Name>Qualified Dividends and Net Capital Gain</Name>
      <Description>Sum for preferential rate calculation.</Description>
      <Derived>
        <Add>
          <Dependency path="/qualifiedDividends1041" />
          <Dependency path="/netCapGainForTaxComp" />
        </Add>
      </Derived>
    </Fact>

    <!-- ============================================ -->
    <!-- FLOW CONTROL                                -->
    <!-- ============================================ -->

    <Fact path="/scheduleD1041IsDone">
      <Name>Schedule D Is Done</Name>
      <Description>Whether Schedule D (1041) is complete.</Description>
      <Derived>
        <IsComplete><Dependency path="/totalCapGainLoss1041" /></IsComplete>
      </Derived>
    </Fact>

    <Fact path="/pdfIncludeScheduleD1041">
      <Name>Include Schedule D in PDF</Name>
      <Description>Whether to include Schedule D (1041) in the tax return PDF.</Description>
      <Derived>
        <Not>
          <Equals>
            <Left><Dependency path="/totalCapGainLoss1041" /></Left>
            <Right><Dollar>0</Dollar></Right>
          </Equals>
        </Not>
      </Derived>
    </Fact>
  </Facts>
</FactDictionaryModule>
