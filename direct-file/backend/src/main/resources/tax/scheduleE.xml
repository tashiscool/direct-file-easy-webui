<?xml-model href="./FactDictionaryModule.rng"?>
<!-- Schedule E: Supplemental Income and Loss (Rental Real Estate, Royalties, etc.) -->
<FactDictionaryModule>
  <Facts>
    <!-- ============================================ -->
    <!-- RENTAL PROPERTY INFORMATION                 -->
    <!-- ============================================ -->

    <Fact path="/hasRentalIncome">
      <Name>Has Rental Income</Name>
      <Description>Whether the taxpayer has rental real estate income or loss.</Description>
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/rentalPropertyAddress">
      <Name>Rental Property Address</Name>
      <Description>Address of the rental property.</Description>
      <Writable>
        <String />
      </Writable>
    </Fact>

    <Fact path="/rentalPropertyType">
      <Name>Rental Property Type</Name>
      <Description>Type of rental property.</Description>
      <Writable>
        <Enum>
          <EnumOption>singleFamily</EnumOption>
          <EnumOption>multiFamily</EnumOption>
          <EnumOption>vacation</EnumOption>
          <EnumOption>commercial</EnumOption>
          <EnumOption>land</EnumOption>
          <EnumOption>selfRental</EnumOption>
          <EnumOption>other</EnumOption>
        </Enum>
      </Writable>
    </Fact>

    <Fact path="/rentalDaysRented">
      <Name>Days Rented at Fair Rental</Name>
      <Description>Number of days property was rented at fair rental value.</Description>
      <Writable>
        <Int>
          <Limit operation="Min" level="ERROR">
            <IntNode>0</IntNode>
          </Limit>
          <Limit operation="Max" level="ERROR">
            <IntNode>365</IntNode>
          </Limit>
        </Int>
      </Writable>
    </Fact>

    <Fact path="/rentalDaysPersonalUse">
      <Name>Days Personal Use</Name>
      <Description>Number of days of personal use of the property.</Description>
      <Writable>
        <Int>
          <Limit operation="Min" level="ERROR">
            <IntNode>0</IntNode>
          </Limit>
          <Limit operation="Max" level="ERROR">
            <IntNode>365</IntNode>
          </Limit>
        </Int>
      </Writable>
    </Fact>

    <Fact path="/activeParticipation">
      <Name>Active Participation</Name>
      <Description>Whether taxpayer actively participated in rental activity.</Description>
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/realEstateProfessional">
      <Name>Real Estate Professional</Name>
      <Description>Whether taxpayer qualifies as a real estate professional.</Description>
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <!-- ============================================ -->
    <!-- RENTAL INCOME                               -->
    <!-- ============================================ -->

    <Fact path="/rentalIncomeReceived">
      <Name>Rents Received</Name>
      <Description>Total rental income received during the year.</Description>
      <Export mef="true" />
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/royaltiesReceived">
      <Name>Royalties Received</Name>
      <Description>Royalty income received during the year.</Description>
      <Export mef="true" />
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/totalRentalRoyaltyIncome">
      <Name>Total Rental and Royalty Income</Name>
      <Description>Combined rental and royalty income.</Description>
      <Derived>
        <Add>
          <Dependency path="/rentalIncomeReceived" />
          <Dependency path="/royaltiesReceived" />
        </Add>
      </Derived>
    </Fact>

