    <!-- ============================================ -->
    <!-- NET FARM PROFIT/LOSS                        -->
    <!-- ============================================ -->

    <Fact path="/farmNetProfitLoss">
      <Name>Net Farm Profit or Loss</Name>
      <Description>Net farm profit (or loss) (Line 34).</Description>
      <Export mef="true" downstreamFacts="true" />
      <Derived>
        <Subtract>
          <Dependency path="/farmGrossIncome" />
          <Dependency path="/farmTotalExpenses" />
        </Subtract>
      </Derived>
    </Fact>

    <Fact path="/farmHasProfit">
      <Name>Farm Has Profit</Name>
      <Description>Whether farm operation has net profit.</Description>
      <Derived>
        <GreaterThan>
          <Left><Dependency path="/farmNetProfitLoss" /></Left>
          <Right><Dollar>0</Dollar></Right>
        </GreaterThan>
      </Derived>
    </Fact>

    <!-- ============================================ -->
    <!-- FLOW CONTROL                                -->
    <!-- ============================================ -->

    <Fact path="/scheduleFIsDone">
      <Name>Schedule F Is Done</Name>
      <Description>Whether Schedule F is complete.</Description>
      <Derived>
        <Any>
          <Not><Dependency path="/hasFarmIncome" /></Not>
          <All>
            <Dependency path="/hasFarmIncome" />
            <IsComplete><Dependency path="/farmGrossIncome" /></IsComplete>
          </All>
        </Any>
      </Derived>
    </Fact>

    <Fact path="/pdfIncludeScheduleF">
      <Name>Include Schedule F in PDF</Name>
      <Description>Whether to include Schedule F in the tax return PDF.</Description>
      <Derived>
        <Dependency path="/hasFarmIncome" />
      </Derived>
    </Fact>
  </Facts>
