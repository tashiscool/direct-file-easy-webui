    <!-- FARM INFORMATION                            -->
    <!-- ============================================ -->

    <Fact path="/hasFarmIncome">
      <Name>Has Farm Income</Name>
      <Description>Whether the taxpayer has farm income or loss.</Description>
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/farmName">
      <Name>Farm Name</Name>
      <Description>Name of farm or principal product.</Description>
      <Writable>
        <String />
      </Writable>
    </Fact>

    <Fact path="/farmEIN">
      <Name>Farm EIN</Name>
      <Description>Employer ID number for farm (if any).</Description>
      <Writable>
        <String />
      </Writable>
    </Fact>

    <Fact path="/farmAccountingMethod">
      <Name>Accounting Method</Name>
      <Description>Cash, accrual, or other accounting method.</Description>
      <Writable>
        <Enum>
          <EnumOption>cash</EnumOption>
          <EnumOption>accrual</EnumOption>
          <EnumOption>other</EnumOption>
        </Enum>
      </Writable>
    </Fact>

    <Fact path="/materiallyParticipatedFarm">
      <Name>Materially Participated</Name>
      <Description>Whether taxpayer materially participated in farm operation.</Description>
