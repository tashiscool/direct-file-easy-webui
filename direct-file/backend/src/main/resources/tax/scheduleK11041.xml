          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <!-- ============================================ -->
    <!-- OTHER INFORMATION                           -->
    <!-- ============================================ -->

    <Fact path="/k11041TaxExemptInterest">
      <Name>Tax-Exempt Interest</Name>
      <Description>Tax-exempt interest (Line 14a).</Description>
      <Export mef="true" />
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/k11041ForeignSourceIncome">
      <Name>Foreign Source Income</Name>
      <Description>Foreign source income (Line 14b).</Description>
