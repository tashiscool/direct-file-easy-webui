<?xml-model href="./FactDictionaryModule.rng"?>
<!-- Schedule K-1 (Form 1041): Beneficiary's Share of Income, Deductions, Credits, etc. -->
<FactDictionaryModule>
  <Facts>
    <!-- ============================================ -->
    <!-- BENEFICIARY INFORMATION (Part I)            -->
    <!-- ============================================ -->

    <Fact path="/hasScheduleK11041">
      <Name>Has Schedule K-1</Name>
      <Description>Whether taxpayer received Schedule K-1 from estate/trust.</Description>
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/beneficiaryTIN">
      <Name>Beneficiary TIN</Name>
      <Description>Beneficiary's identifying number.</Description>
      <Writable>
        <String />
      </Writable>
    </Fact>

    <Fact path="/beneficiaryName">
      <Name>Beneficiary Name</Name>
      <Description>Beneficiary's name.</Description>
      <Writable>
        <String />
      </Writable>
    </Fact>

    <Fact path="/beneficiaryAddress">
      <Name>Beneficiary Address</Name>
      <Description>Beneficiary's address.</Description>
      <Writable>
        <String />
      </Writable>
    </Fact>

    <Fact path="/isForeignBeneficiary">
      <Name>Is Foreign Beneficiary</Name>
      <Description>Whether beneficiary is a foreign person.</Description>
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <!-- ============================================ -->
    <!-- ESTATE/TRUST INFORMATION (Part II)          -->
    <!-- ============================================ -->

    <Fact path="/fiduciaryTIN">
      <Name>Fiduciary TIN</Name>
      <Description>Estate's or trust's EIN.</Description>
      <Writable>
        <String />
      </Writable>
    </Fact>

    <Fact path="/fiduciaryName">
      <Name>Fiduciary Name</Name>
      <Description>Estate's or trust's name.</Description>
      <Writable>
        <String />
      </Writable>
    </Fact>

    <Fact path="/isDecedentsEstate">
      <Name>Is Decedent's Estate</Name>
      <Description>Whether this is from a decedent's estate.</Description>
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/isSimpleTrust">
      <Name>Is Simple Trust</Name>
      <Description>Whether this is a simple trust.</Description>
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/isComplexTrust">
      <Name>Is Complex Trust</Name>
      <Description>Whether this is a complex trust.</Description>
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/isGrantorTrust">
      <Name>Is Grantor Trust</Name>
      <Description>Whether this is a grantor trust.</Description>
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/isBankruptcyEstate">
      <Name>Is Bankruptcy Estate</Name>
      <Description>Whether this is a bankruptcy estate.</Description>
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/isFinalK1">
      <Name>Is Final K-1</Name>
      <Description>Whether this is the final K-1 from this fiduciary.</Description>
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <!-- ============================================ -->
    <!-- PART III: BENEFICIARY'S SHARE OF INCOME     -->
    <!-- ============================================ -->

    <Fact path="/k11041Interest">
      <Name>Interest Income</Name>
      <Description>Interest income (Line 1).</Description>
      <Export mef="true" />
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/k11041OrdinaryDividends">
