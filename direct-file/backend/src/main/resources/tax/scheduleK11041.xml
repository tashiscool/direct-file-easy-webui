    </Fact>

    <!-- ============================================ -->
    <!-- TOTAL INCOME FOR BENEFICIARY                -->
    <!-- ============================================ -->

    <Fact path="/k11041TotalIncome">
      <Name>Total Income from K-1</Name>
      <Description>Total income from Schedule K-1 (Form 1041).</Description>
      <Export mef="true" downstreamFacts="true" />
      <Derived>
        <Add>
          <Add>
            <Add>
              <Dependency path="/k11041Interest" />
              <Dependency path="/k11041OrdinaryDividends" />
            </Add>
            <Add>
              <Dependency path="/k11041NetShortTermCapGain" />
              <Dependency path="/k11041NetLongTermCapGain" />
            </Add>
          </Add>
          <Add>
            <Add>
              <Dependency path="/k11041OtherPortfolioIncome" />
              <Dependency path="/k11041OrdinaryBusinessIncome" />
            </Add>
            <Add>
              <Dependency path="/k11041NetRentalRealEstate" />
              <Dependency path="/k11041OtherRentalIncome" />
            </Add>
          </Add>
        </Add>
      </Derived>
    </Fact>

    <!-- ============================================ -->
    <!-- FLOW CONTROL                                -->
    <!-- ============================================ -->

    <Fact path="/scheduleK11041IsDone">
      <Name>Schedule K-1 Is Done</Name>
      <Description>Whether Schedule K-1 (1041) is complete.</Description>
      <Derived>
        <Any>
          <Not><Dependency path="/hasScheduleK11041" /></Not>
          <All>
            <Dependency path="/hasScheduleK11041" />
            <IsComplete><Dependency path="/k11041TotalIncome" /></IsComplete>
          </All>
        </Any>
      </Derived>
    </Fact>

    <Fact path="/pdfIncludeScheduleK11041">
      <Name>Include Schedule K-1 in PDF</Name>
      <Description>Whether to include Schedule K-1 (1041) in the tax return PDF.</Description>
      <Derived>
        <Dependency path="/hasScheduleK11041" />
      </Derived>
    </Fact>
  </Facts>
</FactDictionaryModule>
