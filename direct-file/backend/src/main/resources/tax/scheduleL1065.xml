                  <Dependency path="/loansToPartnersBOY" />
                </Add>
                <Add>
                  <Dependency path="/mortgageLoansReceivableBOY" />
                  <Dependency path="/otherInvestmentsBOY" />
                </Add>
              </Add>
            </Add>
            <Add>
              <Subtract>
                <Dependency path="/buildingsGrossBOY" />
                <Dependency path="/accumulatedDepreciationBOY" />
              </Subtract>
              <Subtract>
                <Dependency path="/depletableAssetsGrossBOY" />
                <Dependency path="/accumulatedDepletionBOY" />
              </Subtract>
            </Add>
          </Add>
          <Add>
            <Add>
              <Dependency path="/landBOY" />
              <Subtract>
                <Dependency path="/intangibleAssetsGrossBOY" />
                <Dependency path="/accumulatedAmortizationBOY" />
              </Subtract>
            </Add>
            <Dependency path="/otherAssetsBOY" />
          </Add>
        </Add>
      </Derived>
    </Fact>

