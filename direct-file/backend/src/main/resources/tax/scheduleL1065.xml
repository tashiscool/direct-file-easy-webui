    <!-- ============================================ -->
    <!-- BALANCE SHEET VALIDATION                    -->
    <!-- ============================================ -->

    <Fact path="/balanceSheetInBalanceBOY">
      <Name>Balance Sheet In Balance - Beginning of Year</Name>
      <Description>Whether BOY balance sheet balances.</Description>
      <Derived>
        <Equals>
          <Left><Dependency path="/totalAssetsBOY" /></Left>
          <Right>
            <Add>
              <Dependency path="/totalLiabilitiesBOY" />
              <Dependency path="/partnersCapitalBOY" />
            </Add>
          </Right>
        </Equals>
      </Derived>
    </Fact>

    <Fact path="/balanceSheetInBalanceEOY">
      <Name>Balance Sheet In Balance - End of Year</Name>
      <Description>Whether EOY balance sheet balances.</Description>
      <Derived>
        <Equals>
          <Left><Dependency path="/totalAssetsEOY" /></Left>
          <Right>
            <Add>
              <Dependency path="/totalLiabilitiesEOY" />
              <Dependency path="/partnersCapitalEOY" />
            </Add>
          </Right>
        </Equals>
      </Derived>
    </Fact>

    <!-- ============================================ -->
    <!-- FLOW CONTROL                                -->
    <!-- ============================================ -->

    <Fact path="/scheduleLIsDone">
      <Name>Schedule L Is Done</Name>
      <Description>Whether Schedule L is complete.</Description>
      <Derived>
        <All>
          <Dependency path="/balanceSheetInBalanceBOY" />
          <Dependency path="/balanceSheetInBalanceEOY" />
        </All>
      </Derived>
    </Fact>

    <Fact path="/pdfIncludeScheduleL1065">
      <Name>Include Schedule L in PDF</Name>
      <Description>Whether to include Schedule L in the tax return PDF.</Description>
