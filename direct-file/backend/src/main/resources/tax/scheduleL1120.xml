    <Fact path="/totalAssetsCorpBOY">
      <Name>Total Assets - Beginning of Year</Name>
      <Description>Total assets at beginning of year (Line 15).</Description>
      <Export mef="true" />
      <Derived>
        <Add>
          <Add>
            <Add>
              <Dependency path="/cashCorpBOY" />
              <Subtract>
                <Dependency path="/tradeNotesReceivableCorpBOY" />
                <Dependency path="/allowanceForBadDebtsCorpBOY" />
              </Subtract>
            </Add>
            <Add>
              <Dependency path="/inventoriesCorpBOY" />
              <Dependency path="/usGovernmentObligationsCorpBOY" />
            </Add>
          </Add>
          <Add>
            <Add>
              <Dependency path="/taxExemptSecuritiesCorpBOY" />
              <Dependency path="/otherCurrentAssetsCorpBOY" />
            </Add>
            <Add>
              <Add>
                <Dependency path="/loansToShareholdersCorpBOY" />
                <Dependency path="/mortgageLoansCorpBOY" />
              </Add>
              <Add>
                <Add>
                  <Dependency path="/otherInvestmentsCorpBOY" />
                  <Subtract>
                    <Dependency path="/buildingsGrossCorpBOY" />
                    <Dependency path="/accumulatedDepreciationCorpBOY" />
                  </Subtract>
                </Add>
                <Add>
                  <Add>
                    <Subtract>
                      <Dependency path="/depletableAssetsGrossCorpBOY" />
                      <Dependency path="/accumulatedDepletionCorpBOY" />
                    </Subtract>
                    <Dependency path="/landCorpBOY" />
                  </Add>
                  <Add>
                    <Subtract>
                      <Dependency path="/intangibleAssetsGrossCorpBOY" />
                      <Dependency path="/accumulatedAmortizationCorpBOY" />
                    </Subtract>
                    <Dependency path="/otherAssetsCorpBOY" />
                  </Add>
                </Add>
              </Add>
            </Add>
          </Add>
        </Add>
      </Derived>
    </Fact>

