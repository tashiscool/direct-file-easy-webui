<?xml-model href="./FactDictionaryModule.rng"?>
<!-- Schedule M-2 (Form 1065): Analysis of Partners' Capital Accounts -->
<FactDictionaryModule>
  <Facts>
    <!-- ============================================ -->
    <!-- BEGINNING CAPITAL                           -->
    <!-- ============================================ -->

    <Fact path="/partnersCapitalBOYM2">
      <Name>Partners' Capital - Beginning of Year</Name>
      <Description>Balance at beginning of year (Line 1).</Description>
      <Export mef="true" />
      <Writable>
        <Dollar />
      </Writable>
    </Fact>

    <!-- ============================================ -->
    <!-- ADDITIONS TO CAPITAL (Lines 2-4)            -->
    <!-- ============================================ -->

    <Fact path="/capitalContributed">
      <Name>Capital Contributed During Year</Name>
      <Description>Capital contributed during year (Line 2).</Description>
      <Export mef="true" />
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/netIncomePerBooks_M2">
      <Name>Net Income Per Books</Name>
      <Description>Net income per books (Line 3a).</Description>
      <Derived>
        <Max>
          <Dollar>0</Dollar>
          <Dependency module="scheduleM11065" path="/netIncomePerBooks" />
        </Max>
      </Derived>
    </Fact>

    <Fact path="/otherIncreases">
      <Name>Other Increases</Name>
      <Description>Other increases (Line 4).</Description>
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/totalAdditionsM2">
      <Name>Total Additions to Capital</Name>
      <Description>Total of lines 1 through 4 (Line 5).</Description>
      <Export mef="true" />
      <Derived>
        <Add>
          <Add>
            <Add>
              <Dependency path="/partnersCapitalBOYM2" />
              <Dependency path="/capitalContributed" />
            </Add>
            <Dependency path="/netIncomePerBooks_M2" />
          </Add>
          <Dependency path="/otherIncreases" />
        </Add>
      </Derived>
    </Fact>

    <!-- ============================================ -->
    <!-- REDUCTIONS TO CAPITAL (Lines 6-8)           -->
    <!-- ============================================ -->

    <Fact path="/distributionsCash">
      <Name>Distributions - Cash</Name>
      <Description>Cash distributions (Line 6a).</Description>
      <Export mef="true" />
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/distributionsProperty">
      <Name>Distributions - Property</Name>
      <Description>Property distributions (Line 6b).</Description>
      <Export mef="true" />
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/totalDistributions">
      <Name>Total Distributions</Name>
      <Description>Total distributions to partners (Line 6c).</Description>
      <Export mef="true" />
      <Derived>
        <Add>
          <Dependency path="/distributionsCash" />
          <Dependency path="/distributionsProperty" />
        </Add>
      </Derived>
    </Fact>

    <Fact path="/netLossPerBooks_M2">
      <Name>Net Loss Per Books</Name>
      <Description>Net loss per books (Line 7).</Description>
      <Derived>
        <Max>
          <Dollar>0</Dollar>
          <Multiply>
            <Dependency module="scheduleM11065" path="/netIncomePerBooks" />
            <Int>-1</Int>
          </Multiply>
        </Max>
      </Derived>
    </Fact>

    <Fact path="/otherDecreases">
      <Name>Other Decreases</Name>
      <Description>Other decreases (Line 8).</Description>
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/totalReductionsM2">
      <Name>Total Reductions to Capital</Name>
      <Description>Total deductions from capital (Lines 6-8).</Description>
      <Export mef="true" />
      <Derived>
        <Add>
          <Add>
            <Dependency path="/totalDistributions" />
            <Dependency path="/netLossPerBooks_M2" />
          </Add>
          <Dependency path="/otherDecreases" />
        </Add>
      </Derived>
    </Fact>

    <!-- ============================================ -->
    <!-- ENDING CAPITAL                              -->
    <!-- ============================================ -->

    <Fact path="/partnersCapitalEOYM2">
      <Name>Partners' Capital - End of Year</Name>
      <Description>Balance at end of year (Line 9).</Description>
      <Export mef="true" downstreamFacts="true" />
      <Derived>
        <Subtract>
          <Dependency path="/totalAdditionsM2" />
          <Dependency path="/totalReductionsM2" />
        </Subtract>
      </Derived>
    </Fact>

    <!-- ============================================ -->
    <!-- RECONCILIATION WITH SCHEDULE L              -->
    <!-- ============================================ -->

    <Fact path="/capitalReconcilesBOY">
      <Name>Capital Reconciles - Beginning of Year</Name>
      <Description>Whether M-2 BOY capital matches Schedule L.</Description>
      <Derived>
        <Equals>
          <Left><Dependency path="/partnersCapitalBOYM2" /></Left>
          <Right><Dependency module="scheduleL1065" path="/partnersCapitalBOY" /></Right>
        </Equals>
      </Derived>
    </Fact>

    <Fact path="/capitalReconcilesEOY">
      <Name>Capital Reconciles - End of Year</Name>
      <Description>Whether M-2 EOY capital matches Schedule L.</Description>
      <Derived>
        <Equals>
          <Left><Dependency path="/partnersCapitalEOYM2" /></Left>
          <Right><Dependency module="scheduleL1065" path="/partnersCapitalEOY" /></Right>
        </Equals>
      </Derived>
    </Fact>

    <!-- ============================================ -->
    <!-- GUARANTEED PAYMENTS                         -->
    <!-- ============================================ -->

    <Fact path="/guaranteedPaymentsForServices">
      <Name>Guaranteed Payments for Services</Name>
      <Description>Guaranteed payments for services.</Description>
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/guaranteedPaymentsForCapital">
      <Name>Guaranteed Payments for Capital</Name>
      <Description>Guaranteed payments for use of capital.</Description>
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/totalGuaranteedPayments">
      <Name>Total Guaranteed Payments</Name>
      <Description>Total guaranteed payments.</Description>
      <Export mef="true" />
      <Derived>
        <Add>
          <Dependency path="/guaranteedPaymentsForServices" />
          <Dependency path="/guaranteedPaymentsForCapital" />
        </Add>
      </Derived>
    </Fact>

    <!-- ============================================ -->
    <!-- FLOW CONTROL                                -->
    <!-- ============================================ -->

    <Fact path="/scheduleM2IsDone">
      <Name>Schedule M-2 Is Done</Name>
      <Description>Whether Schedule M-2 is complete.</Description>
      <Derived>
        <All>
          <IsComplete><Dependency path="/partnersCapitalBOYM2" /></IsComplete>
          <IsComplete><Dependency path="/partnersCapitalEOYM2" /></IsComplete>
        </All>
      </Derived>
    </Fact>

    <Fact path="/pdfIncludeScheduleM21065">
      <Name>Include Schedule M-2 in PDF</Name>
      <Description>Whether to include Schedule M-2 in the tax return PDF.</Description>
      <Derived>
        <True />
      </Derived>
    </Fact>
  </Facts>
</FactDictionaryModule>
