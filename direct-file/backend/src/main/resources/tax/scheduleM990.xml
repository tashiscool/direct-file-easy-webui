      </Writable>
    </Fact>

    <!-- ============================================ -->
    <!-- TOTALS                                      -->
    <!-- ============================================ -->

    <Fact path="/totalNoncashContributions">
      <Name>Total Noncash Contributions</Name>
      <Description>Total noncash contributions (Line 30).</Description>
      <Export mef="true" downstreamFacts="true" />
      <Derived>
        <Add>
          <Add>
            <Add>
              <Dependency path="/artworkContributions" />
              <Dependency path="/clothingHouseholdContributions" />
            </Add>
            <Add>
              <Dependency path="/publiclyTradedSecurities" />
              <Dependency path="/realEstateCommercial" />
            </Add>
          </Add>
          <Add>
            <Add>
              <Dependency path="/foodInventory" />
              <Dependency path="/drugsAndMedicalSupplies" />
            </Add>
            <Dependency path="/otherNoncashContributions" />
          </Add>
        </Add>
      </Derived>
    </Fact>

    <!-- ============================================ -->
    <!-- PART II: MISCELLANEOUS                      -->
    <!-- ============================================ -->

    <Fact path="/acceptedContributionsForm8283">
      <Name>Accepted Contributions Form 8283</Name>
      <Description>Whether accepted contributions requiring Form 8283 (Line 31).</Description>
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/providedForm8282">
      <Name>Provided Form 8282</Name>
      <Description>Whether provided Form 8282 to donors (Line 32).</Description>
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <Fact path="/hasWrittenPolicyOnProperty">
      <Name>Has Written Policy on Property</Name>
      <Description>Whether has written policy on noncash property acceptance (Line 33).</Description>
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <!-- ============================================ -->
    <!-- FLOW CONTROL                                -->
    <!-- ============================================ -->

    <Fact path="/scheduleM990IsDone">
      <Name>Schedule M Is Done</Name>
      <Description>Whether Schedule M is complete.</Description>
      <Derived>
        <Any>
          <Not><Dependency path="/hasNoncashContributions" /></Not>
          <All>
            <Dependency path="/hasNoncashContributions" />
            <IsComplete><Dependency path="/totalNoncashContributions" /></IsComplete>
          </All>
        </Any>
      </Derived>
    </Fact>

    <Fact path="/pdfIncludeScheduleM990">
      <Name>Include Schedule M in PDF</Name>
      <Description>Whether to include Schedule M (990) in output.</Description>
      <Derived>
        <GreaterThan>
          <Left><Dependency path="/totalNoncashContributions" /></Left>
          <Right><Dollar>25000</Dollar></Right>
        </GreaterThan>
      </Derived>
    </Fact>
  </Facts>
</FactDictionaryModule>
