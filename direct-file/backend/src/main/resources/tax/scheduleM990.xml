<?xml-model href="./FactDictionaryModule.rng"?>
<!-- Schedule M (Form 990): Noncash Contributions -->
<FactDictionaryModule>
  <Facts>
    <!-- ============================================ -->
    <!-- NONCASH CONTRIBUTIONS                       -->
    <!-- ============================================ -->

    <Fact path="/hasNoncashContributions">
      <Name>Has Noncash Contributions</Name>
      <Description>Whether organization received noncash contributions over $25,000.</Description>
      <Export mef="true" />
      <Writable>
        <Boolean />
      </Writable>
    </Fact>

    <!-- ============================================ -->
    <!-- PART I: TYPES OF PROPERTY                   -->
    <!-- ============================================ -->

    <!-- Art and Collectibles -->
    <Fact path="/artworkContributions">
      <Name>Artwork Contributions</Name>
      <Description>Art - Works of art (Line 1).</Description>
      <Export mef="true" />
      <Writable>
        <Dollar>
          <Limit operation="Min" level="ERROR">
            <DollarNode>0</DollarNode>
          </Limit>
        </Dollar>
      </Writable>
    </Fact>

    <Fact path="/artworkContributionsCount">
      <Name>Artwork Contributions Count</Name>
      <Description>Number of contributions of artwork (Line 1).</Description>
      <Writable>
        <Int>
          <Limit operation="Min" level="ERROR">
            <IntNode>0</IntNode>
          </Limit>
        </Int>
      </Writable>
    </Fact>

    <Fact path="/historicalTreasures">
      <Name>Historical Treasures</Name>
      <Description>Art - Historical treasures (Line 2).</Description>
