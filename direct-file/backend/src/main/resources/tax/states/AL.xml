<?xml-model href="../FactDictionaryModule.rng"?>
<!-- Alabama Form 40: Individual Income Tax Return -->
<!-- Alabama has progressive rates from 2% to 5% -->
<FactDictionaryModule>
  <Facts>
    <Fact path="/hasAL40">
      <Name>Has AL Form 40</Name>
      <Description>Whether taxpayer files Alabama Form 40.</Description>
      <Export mef="true" />
      <Derived>
        <Equal>
          <Left><Dependency path="/stateOfResidence" /></Left>
          <Right><String>AL</String></Right>
        </Equal>
      </Derived>
    </Fact>

    <!-- AL Standard Deduction -->
    <Fact path="/alStdDeductionSingle">
      <Name>AL Standard Deduction Single</Name>
      <Description>Alabama standard deduction for single ($2,500).</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Dollar>2500</Dollar>
      </Derived>
    </Fact>

    <Fact path="/alStdDeductionMFJ">
      <Name>AL Standard Deduction MFJ</Name>
      <Description>Alabama standard deduction for MFJ ($7,500).</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Dollar>7500</Dollar>
      </Derived>
    </Fact>

    <Fact path="/alStandardDeduction">
      <Name>AL Standard Deduction</Name>
      <Description>Alabama standard deduction based on filing status.</Description>
      <Derived>
        <Switch>
          <Case>
            <When>
              <Equal>
                <Left><Dependency path="/filingStatus" /></Left>
                <Right><String>MFJ</String></Right>
              </Equal>
            </When>
            <Then><Dependency path="/alStdDeductionMFJ" /></Then>
          </Case>
          <Default><Dependency path="/alStdDeductionSingle" /></Default>
        </Switch>
      </Derived>
    </Fact>

    <!-- AL Personal Exemption -->
    <Fact path="/alPersonalExemption">
      <Name>AL Personal Exemption</Name>
      <Description>Alabama personal exemption ($1,500).</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Dollar>1500</Dollar>
      </Derived>
    </Fact>

    <!-- AL Taxable Income -->
    <Fact path="/alTaxableIncome">
      <Name>AL Taxable Income</Name>
      <Description>Alabama taxable income.</Description>
      <Derived>
        <Max>
          <Subtract>
            <Subtract>
              <Dependency path="/adjustedGrossIncome" />
              <Dependency path="/alStandardDeduction" />
            </Subtract>
            <Dependency path="/alPersonalExemption" />
          </Subtract>
          <Dollar>0</Dollar>
        </Max>
      </Derived>
    </Fact>

    <!-- AL Income Tax (progressive: 2% up to $500, 4% $500-$3000, 5% over $3000) -->
    <Fact path="/alIncomeTax">
      <Name>AL Income Tax</Name>
      <Description>Alabama income tax.</Description>
      <Export mef="true" downstreamFacts="true" />
      <Derived>
        <Switch>
          <Case>
            <When>
              <LessThanOrEqual>
                <Left><Dependency path="/alTaxableIncome" /></Left>
                <Right><Dollar>500</Dollar></Right>
              </LessThanOrEqual>
            </When>
            <Then>
              <Multiply>
                <Dependency path="/alTaxableIncome" />
                <Decimal>0.02</Decimal>
              </Multiply>
            </Then>
          </Case>
          <Case>
            <When>
              <LessThanOrEqual>
                <Left><Dependency path="/alTaxableIncome" /></Left>
                <Right><Dollar>3000</Dollar></Right>
              </LessThanOrEqual>
            </When>
            <Then>
              <Add>
                <Dollar>10</Dollar>
                <Multiply>
                  <Subtract>
                    <Dependency path="/alTaxableIncome" />
                    <Dollar>500</Dollar>
                  </Subtract>
                  <Decimal>0.04</Decimal>
                </Multiply>
              </Add>
            </Then>
          </Case>
          <Default>
            <Add>
              <Dollar>110</Dollar>
              <Multiply>
                <Subtract>
                  <Dependency path="/alTaxableIncome" />
                  <Dollar>3000</Dollar>
                </Subtract>
                <Decimal>0.05</Decimal>
              </Multiply>
            </Add>
          </Default>
        </Switch>
      </Derived>
    </Fact>

    <Fact path="/al40IsDone">
      <Name>AL Form 40 Is Done</Name>
      <Description>Whether AL Form 40 is complete.</Description>
      <Derived>
        <Any>
          <Not><Dependency path="/hasAL40" /></Not>
          <All>
            <Dependency path="/hasAL40" />
            <IsComplete><Dependency path="/alIncomeTax" /></IsComplete>
          </All>
        </Any>
      </Derived>
    </Fact>

    <Fact path="/pdfIncludeAL40">
      <Name>Include AL Form 40 in PDF</Name>
      <Description>Whether to include AL Form 40.</Description>
      <Derived>
        <Dependency path="/hasAL40" />
      </Derived>
    </Fact>
  </Facts>
</FactDictionaryModule>
