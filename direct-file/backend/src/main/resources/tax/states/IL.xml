<?xml-model href="../FactDictionaryModule.rng"?>
<!-- Illinois IL-1040: Individual Income Tax Return -->
<!-- Illinois uses a flat 4.95% income tax rate -->
<FactDictionaryModule>
  <Facts>
    <Fact path="/hasIL1040">
      <Name>Has IL-1040</Name>
      <Description>Whether taxpayer files Illinois IL-1040.</Description>
      <Export mef="true" />
      <Derived>
        <Equal>
          <Left><Dependency path="/stateOfResidence" /></Left>
          <Right><String>IL</String></Right>
        </Equal>
      </Derived>
    </Fact>

    <!-- Illinois Tax Rate (flat) -->
    <Fact path="/ilTaxRate">
      <Name>Illinois Tax Rate</Name>
      <Description>Illinois flat income tax rate (4.95%).</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Decimal>0.0495</Decimal>
      </Derived>
    </Fact>

    <!-- Illinois Exemption Amount -->
    <Fact path="/ilExemptionSingle">
      <Name>IL Exemption Single</Name>
      <Description>Illinois personal exemption for single filers ($2,625).</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Dollar>2625</Dollar>
      </Derived>
    </Fact>

    <Fact path="/ilExemptionMFJ">
      <Name>IL Exemption MFJ</Name>
      <Description>Illinois personal exemption for MFJ ($5,250).</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Dollar>5250</Dollar>
      </Derived>
    </Fact>

    <Fact path="/ilDependentExemption">
      <Name>IL Dependent Exemption</Name>
      <Description>Illinois dependent exemption ($2,625 each).</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Dollar>2625</Dollar>
      </Derived>
    </Fact>

    <!-- IL Line 1 - Federal AGI -->
    <Fact path="/ilLine1">
      <Name>IL Line 1</Name>
      <Description>Federal adjusted gross income.</Description>
      <Derived>
        <Dependency path="/adjustedGrossIncome" />
      </Derived>
    </Fact>

    <!-- IL Line 5 - Social Security Subtraction (IL doesn't tax SS) -->
    <Fact path="/ilLine5">
      <Name>IL Line 5</Name>
      <Description>Social Security benefits and retirement income subtraction.</Description>
      <Derived>
        <Dependency path="/taxableSocialSecurity" />
      </Derived>
    </Fact>

    <!-- IL Line 9 - Illinois Base Income -->
    <Fact path="/ilLine9">
      <Name>IL Line 9</Name>
      <Description>Illinois base income after subtractions.</Description>
      <Derived>
        <Max>
          <Subtract>
            <Dependency path="/ilLine1" />
            <Dependency path="/ilLine5" />
          </Subtract>
          <Dollar>0</Dollar>
        </Max>
      </Derived>
    </Fact>

    <!-- IL Line 10 - Exemption Allowance -->
    <Fact path="/ilLine10">
      <Name>IL Line 10</Name>
      <Description>Illinois exemption allowance.</Description>
      <Derived>
        <Switch>
          <Case>
            <When>
              <Equal>
                <Left><Dependency path="/filingStatus" /></Left>
                <Right><String>MFJ</String></Right>
              </Equal>
            </When>
            <Then><Dependency path="/ilExemptionMFJ" /></Then>
          </Case>
          <Default><Dependency path="/ilExemptionSingle" /></Default>
        </Switch>
      </Derived>
    </Fact>

    <!-- IL Line 11 - Net Income -->
    <Fact path="/ilLine11">
      <Name>IL Line 11</Name>
      <Description>Illinois net income.</Description>
      <Derived>
        <Max>
          <Subtract>
            <Dependency path="/ilLine9" />
            <Dependency path="/ilLine10" />
          </Subtract>
          <Dollar>0</Dollar>
        </Max>
      </Derived>
    </Fact>

    <!-- IL Line 12 - Illinois Income Tax -->
    <Fact path="/ilLine12">
      <Name>IL Line 12</Name>
      <Description>Illinois income tax (Line 11 x 4.95%).</Description>
      <Export mef="true" downstreamFacts="true" />
      <Derived>
        <Multiply>
          <Dependency path="/ilLine11" />
          <Dependency path="/ilTaxRate" />
        </Multiply>
      </Derived>
    </Fact>

    <!-- ======================= -->
    <!-- IL EITC - 20% of Federal EIC -->
    <!-- ======================= -->
    <Fact path="/ilEICRate">
      <Name>IL EIC Rate</Name>
      <Description>Illinois EIC as percentage of federal (20%).</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Decimal>0.20</Decimal>
      </Derived>
    </Fact>

    <Fact path="/ilEarnedIncomeCredit">
      <Name>IL Earned Income Credit</Name>
      <Description>Illinois Earned Income Credit (20% of federal EIC).</Description>
      <Export mef="true" />
      <Derived>
        <Multiply>
          <Dependency path="/earnedIncomeCredit" />
          <Dependency path="/ilEICRate" />
        </Multiply>
      </Derived>
    </Fact>

    <!-- ======================= -->
    <!-- IL PROPERTY TAX CREDIT -->
    <!-- ======================= -->
    <Fact path="/ilPropertyTaxPaid">
      <Name>IL Property Tax Paid</Name>
      <Description>Property taxes paid on principal residence in Illinois.</Description>
      <Placeholder>0</Placeholder>
    </Fact>

    <Fact path="/ilPropertyTaxCreditRate">
      <Name>IL Property Tax Credit Rate</Name>
      <Description>Illinois property tax credit rate (5%).</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Decimal>0.05</Decimal>
      </Derived>
    </Fact>

    <Fact path="/ilPropertyTaxCredit">
      <Name>IL Property Tax Credit</Name>
      <Description>Illinois Property Tax Credit (5% of property taxes paid on principal residence).</Description>
      <Export mef="true" />
      <Derived>
        <Multiply>
          <Dependency path="/ilPropertyTaxPaid" />
          <Dependency path="/ilPropertyTaxCreditRate" />
        </Multiply>
      </Derived>
    </Fact>

    <!-- ======================= -->
    <!-- IL EDUCATION EXPENSE CREDIT (K-12) -->
    <!-- ======================= -->
    <Fact path="/ilK12Expenses">
      <Name>IL K-12 Education Expenses</Name>
      <Description>Qualified K-12 education expenses for Illinois residents.</Description>
      <Placeholder>0</Placeholder>
    </Fact>

    <Fact path="/ilEducationExpenseMaxPerStudent">
      <Name>IL Education Expense Max Per Student</Name>
      <Description>Maximum qualifying K-12 expenses per student ($750).</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Dollar>750</Dollar>
      </Derived>
    </Fact>

    <Fact path="/ilEducationExpenseCreditRate">
      <Name>IL Education Expense Credit Rate</Name>
      <Description>Illinois K-12 education expense credit rate (25%).</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Decimal>0.25</Decimal>
      </Derived>
    </Fact>

    <Fact path="/ilNumberOfK12Students">
      <Name>IL Number of K-12 Students</Name>
      <Description>Number of K-12 students in household.</Description>
      <Placeholder>0</Placeholder>
    </Fact>

    <Fact path="/ilEducationExpenseMaxTotal">
      <Name>IL Education Expense Max Total</Name>
      <Description>Total maximum qualifying K-12 expenses.</Description>
      <Derived>
        <Multiply>
          <Dependency path="/ilEducationExpenseMaxPerStudent" />
          <Dependency path="/ilNumberOfK12Students" />
        </Multiply>
      </Derived>
    </Fact>

    <Fact path="/ilEducationExpenseCredit">
      <Name>IL Education Expense Credit</Name>
      <Description>Illinois K-12 Education Expense Credit.</Description>
      <Export mef="true" />
      <Derived>
        <Multiply>
          <Min>
            <Dependency path="/ilK12Expenses" />
            <Dependency path="/ilEducationExpenseMaxTotal" />
          </Min>
          <Dependency path="/ilEducationExpenseCreditRate" />
        </Multiply>
      </Derived>
    </Fact>

    <!-- ======================= -->
    <!-- IL ADOPTION CREDIT -->
    <!-- ======================= -->
    <Fact path="/ilAdoptionExpenses">
      <Name>IL Adoption Expenses</Name>
      <Description>Qualified adoption expenses paid in Illinois.</Description>
      <Placeholder>0</Placeholder>
    </Fact>

    <Fact path="/ilAdoptedChild">
      <Name>IL Adopted Child</Name>
      <Description>Whether taxpayer legally adopted a child during the tax year.</Description>
      <Placeholder>false</Placeholder>
    </Fact>

    <Fact path="/ilAdoptionCreditMaxAmount">
      <Name>IL Adoption Credit Max Amount</Name>
      <Description>Maximum Illinois Adoption Credit ($5,000).</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Dollar>5000</Dollar>
      </Derived>
    </Fact>

    <Fact path="/ilAdoptionCreditEligible">
      <Name>IL Adoption Credit Eligible</Name>
      <Description>Whether taxpayer is eligible for Illinois Adoption Credit.</Description>
      <Derived>
        <All>
          <Dependency path="/ilAdoptedChild" />
          <GreaterThan>
            <Left><Dependency path="/ilAdoptionExpenses" /></Left>
            <Right><Dollar>0</Dollar></Right>
          </GreaterThan>
        </All>
      </Derived>
    </Fact>

    <Fact path="/ilAdoptionCredit">
      <Name>IL Adoption Credit</Name>
      <Description>Illinois Adoption Credit for qualified adoption expenses.</Description>
      <Export mef="true" />
      <Derived>
        <Switch>
          <Case>
            <When>
              <Not><Dependency path="/ilAdoptionCreditEligible" /></Not>
            </When>
            <Then><Dollar>0</Dollar></Then>
          </Case>
          <Default>
            <Min>
              <Dependency path="/ilAdoptionExpenses" />
              <Dependency path="/ilAdoptionCreditMaxAmount" />
            </Min>
          </Default>
        </Switch>
      </Derived>
    </Fact>

    <!-- ======================= -->
    <!-- IL TOTAL CREDITS -->
    <!-- ======================= -->
    <Fact path="/ilTotalCredits">
      <Name>IL Total Credits</Name>
      <Description>Total Illinois credits.</Description>
      <Export mef="true" />
      <Derived>
        <Add>
          <Dependency path="/ilEarnedIncomeCredit" />
          <Add>
            <Dependency path="/ilPropertyTaxCredit" />
            <Add>
              <Dependency path="/ilEducationExpenseCredit" />
              <Dependency path="/ilAdoptionCredit" />
            </Add>
          </Add>
        </Add>
      </Derived>
    </Fact>

    <!-- IL Net Tax -->
    <Fact path="/ilNetTax">
      <Name>IL Net Tax</Name>
      <Description>Illinois net tax after credits.</Description>
      <Export mef="true" />
      <Derived>
        <Max>
          <Subtract>
            <Dependency path="/ilLine12" />
            <Dependency path="/ilTotalCredits" />
          </Subtract>
          <Dollar>0</Dollar>
        </Max>
      </Derived>
    </Fact>

    <!-- IL Refundable Credits (IL EIC is refundable) -->
    <Fact path="/ilRefundableCredits">
      <Name>IL Refundable Credits</Name>
      <Description>Total Illinois refundable credits.</Description>
      <Export mef="true" />
      <Derived>
        <Dependency path="/ilEarnedIncomeCredit" />
      </Derived>
    </Fact>

    <Fact path="/il1040IsDone">
      <Name>IL-1040 Is Done</Name>
      <Description>Whether IL-1040 is complete.</Description>
      <Derived>
        <Any>
          <Not><Dependency path="/hasIL1040" /></Not>
          <All>
            <Dependency path="/hasIL1040" />
            <IsComplete><Dependency path="/ilNetTax" /></IsComplete>
          </All>
        </Any>
      </Derived>
    </Fact>

    <Fact path="/pdfIncludeIL1040">
      <Name>Include IL-1040 in PDF</Name>
      <Description>Whether to include IL-1040.</Description>
      <Derived>
        <Dependency path="/hasIL1040" />
      </Derived>
    </Fact>
  </Facts>
</FactDictionaryModule>
