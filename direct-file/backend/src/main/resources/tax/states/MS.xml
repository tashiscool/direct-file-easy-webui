<?xml-model href="../FactDictionaryModule.rng"?>
<!-- Mississippi Form 80-105: Individual Income Tax Return -->
<!-- Mississippi has a flat 4.7% rate (as of 2024, transitioning to 4% by 2026) -->
<FactDictionaryModule>
  <Facts>
    <Fact path="/hasMS80105">
      <Name>Has MS Form 80-105</Name>
      <Description>Whether taxpayer files Mississippi Form 80-105.</Description>
      <Export mef="true" />
      <Derived>
        <Equal>
          <Left><Dependency path="/stateOfResidence" /></Left>
          <Right><String>MS</String></Right>
        </Equal>
      </Derived>
    </Fact>

    <!-- MS Tax Rate -->
    <Fact path="/msTaxRate">
      <Name>Mississippi Tax Rate</Name>
      <Description>Mississippi income tax rate (4.7% for 2025).</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Decimal>0.047</Decimal>
      </Derived>
    </Fact>

    <!-- MS Standard Deduction -->
    <Fact path="/msStdDeductionSingle">
      <Name>MS Standard Deduction Single</Name>
      <Description>Mississippi standard deduction for single ($2,300).</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Dollar>2300</Dollar>
      </Derived>
    </Fact>

    <Fact path="/msStdDeductionMFJ">
      <Name>MS Standard Deduction MFJ</Name>
      <Description>Mississippi standard deduction for MFJ ($4,600).</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Dollar>4600</Dollar>
      </Derived>
    </Fact>

    <Fact path="/msStandardDeduction">
      <Name>MS Standard Deduction</Name>
      <Description>Mississippi standard deduction based on filing status.</Description>
      <Derived>
        <Switch>
          <Case>
            <When>
              <Equal>
                <Left><Dependency path="/filingStatus" /></Left>
                <Right><String>MFJ</String></Right>
              </Equal>
            </When>
            <Then><Dependency path="/msStdDeductionMFJ" /></Then>
          </Case>
          <Default><Dependency path="/msStdDeductionSingle" /></Default>
        </Switch>
      </Derived>
    </Fact>

    <!-- MS Personal Exemption -->
    <Fact path="/msPersonalExemptionSingle">
      <Name>MS Personal Exemption Single</Name>
      <Description>Mississippi personal exemption for single ($6,000).</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Dollar>6000</Dollar>
      </Derived>
    </Fact>

    <Fact path="/msPersonalExemptionMFJ">
      <Name>MS Personal Exemption MFJ</Name>
      <Description>Mississippi personal exemption for MFJ ($12,000).</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Dollar>12000</Dollar>
      </Derived>
    </Fact>

    <Fact path="/msPersonalExemption">
      <Name>MS Personal Exemption</Name>
      <Description>Mississippi personal exemption based on filing status.</Description>
      <Derived>
        <Switch>
          <Case>
            <When>
              <Equal>
                <Left><Dependency path="/filingStatus" /></Left>
                <Right><String>MFJ</String></Right>
              </Equal>
            </When>
            <Then><Dependency path="/msPersonalExemptionMFJ" /></Then>
          </Case>
          <Default><Dependency path="/msPersonalExemptionSingle" /></Default>
        </Switch>
      </Derived>
    </Fact>

    <!-- MS Taxable Income -->
    <Fact path="/msTaxableIncome">
      <Name>MS Taxable Income</Name>
      <Description>Mississippi taxable income.</Description>
      <Derived>
        <Max>
          <Subtract>
            <Subtract>
              <Dependency path="/adjustedGrossIncome" />
              <Dependency path="/msStandardDeduction" />
            </Subtract>
            <Dependency path="/msPersonalExemption" />
          </Subtract>
          <Dollar>0</Dollar>
        </Max>
      </Derived>
    </Fact>

    <!-- MS Income Tax (first $10,000 exempt) -->
    <Fact path="/msIncomeTax">
      <Name>MS Income Tax</Name>
      <Description>Mississippi income tax.</Description>
      <Export mef="true" downstreamFacts="true" />
      <Derived>
        <Switch>
          <Case>
            <When>
              <LessThanOrEqual>
                <Left><Dependency path="/msTaxableIncome" /></Left>
                <Right><Dollar>10000</Dollar></Right>
              </LessThanOrEqual>
            </When>
            <Then><Dollar>0</Dollar></Then>
          </Case>
          <Default>
            <Multiply>
              <Subtract>
                <Dependency path="/msTaxableIncome" />
                <Dollar>10000</Dollar>
              </Subtract>
              <Dependency path="/msTaxRate" />
            </Multiply>
          </Default>
        </Switch>
      </Derived>
    </Fact>

    <Fact path="/ms80105IsDone">
      <Name>MS Form 80-105 Is Done</Name>
      <Description>Whether MS Form 80-105 is complete.</Description>
      <Derived>
        <Any>
          <Not><Dependency path="/hasMS80105" /></Not>
          <All>
            <Dependency path="/hasMS80105" />
            <IsComplete><Dependency path="/msIncomeTax" /></IsComplete>
          </All>
        </Any>
      </Derived>
    </Fact>

    <Fact path="/pdfIncludeMS80105">
      <Name>Include MS Form 80-105 in PDF</Name>
      <Description>Whether to include MS Form 80-105.</Description>
      <Derived>
        <Dependency path="/hasMS80105" />
      </Derived>
    </Fact>
  </Facts>
</FactDictionaryModule>
