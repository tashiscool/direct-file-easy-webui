<?xml-model href="../FactDictionaryModule.rng"?>
<!-- West Virginia Form IT-140: Resident Income Tax Return -->
<!-- West Virginia has progressive rates from 2.36% to 5.12% -->
<FactDictionaryModule>
  <Facts>
    <Fact path="/hasWVIT140">
      <Name>Has WV Form IT-140</Name>
      <Description>Whether taxpayer files West Virginia Form IT-140.</Description>
      <Export mef="true" />
      <Derived>
        <Equal>
          <Left><Dependency path="/stateOfResidence" /></Left>
          <Right><String>WV</String></Right>
        </Equal>
      </Derived>
    </Fact>

    <!-- WV uses federal AGI as starting point, no standard deduction -->
    <Fact path="/wvPersonalExemption">
      <Name>WV Personal Exemption</Name>
      <Description>West Virginia personal exemption ($2,000).</Description>
      <TaxYear>2025</TaxYear>
      <Derived>
        <Dollar>2000</Dollar>
      </Derived>
    </Fact>

    <!-- WV Taxable Income -->
    <Fact path="/wvTaxableIncome">
      <Name>WV Taxable Income</Name>
      <Description>West Virginia taxable income.</Description>
      <Derived>
        <Max>
          <Subtract>
            <Dependency path="/adjustedGrossIncome" />
            <Dependency path="/wvPersonalExemption" />
          </Subtract>
          <Dollar>0</Dollar>
        </Max>
      </Derived>
    </Fact>

    <!-- WV Income Tax (progressive) -->
    <Fact path="/wvIncomeTax">
      <Name>WV Income Tax</Name>
      <Description>West Virginia income tax.</Description>
      <Export mef="true" downstreamFacts="true" />
      <Derived>
        <Switch>
          <Case>
            <When>
              <LessThanOrEqual>
                <Left><Dependency path="/wvTaxableIncome" /></Left>
                <Right><Dollar>10000</Dollar></Right>
              </LessThanOrEqual>
            </When>
            <Then>
              <Multiply>
                <Dependency path="/wvTaxableIncome" />
                <Decimal>0.0236</Decimal>
              </Multiply>
            </Then>
          </Case>
          <Case>
            <When>
              <LessThanOrEqual>
                <Left><Dependency path="/wvTaxableIncome" /></Left>
                <Right><Dollar>25000</Dollar></Right>
              </LessThanOrEqual>
            </When>
            <Then>
              <Add>
                <Dollar>236</Dollar>
                <Multiply>
                  <Subtract>
                    <Dependency path="/wvTaxableIncome" />
                    <Dollar>10000</Dollar>
                  </Subtract>
                  <Decimal>0.0315</Decimal>
                </Multiply>
              </Add>
            </Then>
          </Case>
          <Case>
            <When>
              <LessThanOrEqual>
                <Left><Dependency path="/wvTaxableIncome" /></Left>
                <Right><Dollar>40000</Dollar></Right>
              </LessThanOrEqual>
            </When>
            <Then>
              <Add>
                <Dollar>709</Dollar>
                <Multiply>
                  <Subtract>
                    <Dependency path="/wvTaxableIncome" />
                    <Dollar>25000</Dollar>
                  </Subtract>
                  <Decimal>0.0354</Decimal>
                </Multiply>
              </Add>
            </Then>
          </Case>
          <Case>
            <When>
              <LessThanOrEqual>
                <Left><Dependency path="/wvTaxableIncome" /></Left>
                <Right><Dollar>60000</Dollar></Right>
              </LessThanOrEqual>
            </When>
            <Then>
              <Add>
                <Dollar>1240</Dollar>
                <Multiply>
                  <Subtract>
                    <Dependency path="/wvTaxableIncome" />
                    <Dollar>40000</Dollar>
                  </Subtract>
                  <Decimal>0.0472</Decimal>
                </Multiply>
              </Add>
            </Then>
          </Case>
          <Default>
            <Add>
              <Dollar>2184</Dollar>
              <Multiply>
                <Subtract>
                  <Dependency path="/wvTaxableIncome" />
                  <Dollar>60000</Dollar>
                </Subtract>
                <Decimal>0.0512</Decimal>
              </Multiply>
            </Add>
          </Default>
        </Switch>
      </Derived>
    </Fact>

    <Fact path="/wvit140IsDone">
      <Name>WV Form IT-140 Is Done</Name>
      <Description>Whether WV Form IT-140 is complete.</Description>
      <Derived>
        <Any>
          <Not><Dependency path="/hasWVIT140" /></Not>
          <All>
            <Dependency path="/hasWVIT140" />
            <IsComplete><Dependency path="/wvIncomeTax" /></IsComplete>
          </All>
        </Any>
      </Derived>
    </Fact>

    <Fact path="/pdfIncludeWVIT140">
      <Name>Include WV Form IT-140 in PDF</Name>
      <Description>Whether to include WV Form IT-140.</Description>
      <Derived>
        <Dependency path="/hasWVIT140" />
      </Derived>
    </Fact>
  </Facts>
</FactDictionaryModule>
